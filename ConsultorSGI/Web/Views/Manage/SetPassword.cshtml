@model Web.Models.ChangePasswordViewModel


<div class="content-header pt-0 mt-0 pb-1">
    <div class="container-fluid pt-0 mt-0">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="text-dark font-weight-bold">Crear contraseña</h1>
                <small>Recuerde cambiar su contraseña periodicamente</small>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Manage")">Mi perfil</a></li>
                    <li class="breadcrumb-item active">Crear contraseña</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card card-primary card-outline">
    <form id="formCrearNuevoPassword">

        @Html.AntiForgeryToken()

        <div class="card-body box-profile">

            <div class="row">

                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-control-label font-weight-bold" for="usuarioContraseñaNueva">Nueva contraseña<span class="text-danger">*</span></label>
                        <div class=" input-group with-focus">
                            <input class="form-control border-right-0" type="password" id="usuarioContraseñaNueva" placeholder="Ingrese la nueva contraseña aquí..." autocomplete="off" minlength="" maxlength="15" required />
                            <div class="input-group-append">
                                <span class="input-group-text text-muted bg-transparent border-left-0">
                                    <i class="fas fa-unlock-alt"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-control-label font-weight-bold" for="usuarioConfirmarContraseña">Confirmar contraseña<span class="text-danger">*</span></label>
                        <div class=" input-group with-focus">
                            <input class="form-control border-right-0" type="password" id="usuarioConfirmarContraseña" placeholder="Ingrese la confirmación de la contraseña aquí..." autocomplete="off" minlength="3" maxlength="15" required />
                            <div class="input-group-append">
                                <span class="input-group-text text-muted bg-transparent border-left-0">
                                    <i class="fas fa-lock"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <div class="row">
                <div class="col-md-2">

                </div>
                <div class="col-md-2">

                </div>

                <div class="col-md-4">
                    <a href="@Url.Action("Index","Manage")" class="btn btn-outline-dark btn-block"><i class="fas fa-undo-alt mr-1"></i>Atras</a>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-primary btn-block"><i class="fas fa-cloud-upload-alt mr-1"></i>Guardar</button>

                </div>

            </div>
        </div>

    </form>
</div>

@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {
        manage.crearNuevaPassword();

    });

</script>
