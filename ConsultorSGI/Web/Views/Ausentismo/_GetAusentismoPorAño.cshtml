@model List<Models.DTO.AusentismoAgrupadoMensualmentePorAnioDTO>
@using CoreBusiness;
@{
    TipoEventosAusentismoCoreBusiness _tipoEventosAusentismoCoreBusiness = new TipoEventosAusentismoCoreBusiness();
    var listaEventosAusentismo = _tipoEventosAusentismoCoreBusiness.GetAll().Where(x => x.BitActivo == true).OrderBy(x => x.IntTipoEventoAusentismoID);
}

<div class=" container-fluid">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center m-2" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <form id="formCrearGlobal">
            @Html.AntiForgeryToken()
            <div class="card card-primary card-outline">
                <div class="card-header ">
                    <a href="#"><i class="fas fa-angle-double-left fa-2x mr-2" onclick="ausentismoCRUD.getAusentismoAgrupadoMensualmentePorAñoAsync(-1)"></i></a>
                    <span class="h2 font-weight-bold" id="ausentismoAnio">@ViewBag.anio</span>
                    <a href="#"><i class="fas fa-angle-double-right fa-2x ml-2" onclick="ausentismoCRUD.getAusentismoAgrupadoMensualmentePorAñoAsync(1)"></i></a>

                    <button type="button" class="btn btn-outline-dark float-right" onclick="ausentismoCRUD.getAllAusentismoAsync()"><i class="fas fa-undo-alt mr-1"></i>Voler a ausentismo</button>

                </div>
                <div class="card-body box-profile">
                    <div class="card-title">
                        <p class="font-weight-bold text-primary font-italic h5">Ausentismo agrupado por mes</p>
                    </div>
                    <table id="tblAusentismoAgrupado" class="table dt-responsive table-sm center-block" style="width:100%">
                        <thead class="text-center">
                            <tr>
                                <th style="display:none">Id</th>
                                <th class="text-left">MES</th>
                                @foreach (var item in listaEventosAusentismo)
                                {
                                    <th>@item.StrCodigo</th>
                                }

                                <th>Total dias</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var periodo in Model)
                            {
                                <tr>
                                    <td style="display:none">@periodo.Mes</td>
                                    <td class="h6">@periodo.MesNombre</td>

                                    @foreach (var tipoEvento in listaEventosAusentismo)
                                    {
                                        if (periodo.ListaAusentismoAgrupadoPorTipoEvento.Where(x => x.TipoAusentismoID == tipoEvento.IntTipoEventoAusentismoID).Count() != 0)
                                        {
                                            <td class="text-center">@periodo.ListaAusentismoAgrupadoPorTipoEvento.Where(x => x.TipoAusentismoCodigo == tipoEvento.StrCodigo).FirstOrDefault().DiasAusentismo</td>

                                        }
                                        else
                                        {
                                            <td class="text-center">0</td>
                                        }
                                    }

                                    <td class="text-center h5 font-weight-bold">@periodo.TotalDiasIncapacidad</td>

                                    <td class="text-center">
                                        <button type="button" title="Ver empleados" data-toggle="tooltip" data-placement="left" class="btn btn-outline-primary btn-sm glyphicon glyphicon-user" data-periodo="@periodo.Mes" data-tipoevento="buscarEmpleados"><i class="fa fa-users fa-fw"></i></button>

                                    </td>

                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <td class="text-left font-weight-bold h5">TOTAL</td>
                                @foreach (var item in listaEventosAusentismo)
                                {
                                    <th>&nbsp;</th>

                                }
                                <td class="text-center h4 font-weight-bold ">@Model.Sum(x => x.TotalDiasIncapacidad)</td>
                                <td>&nbsp;</td>

                            </tr>
                        </tfoot>
                    </table>

                </div>
            </div>
        </form>

    }

</div>

@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {

        $('#tblAusentismoAgrupado tbody').on('click', 'button', function () {

            var tipoEvento = $(this).data("tipoevento");
            var periodo = $(this).data("periodo");

            if (tipoEvento == 'buscarEmpleados') return ausentismoCRUD.getAusentismoAgrupadoMensualmentePorEmpleadoAsync(periodo);

        });


    });


</script>



