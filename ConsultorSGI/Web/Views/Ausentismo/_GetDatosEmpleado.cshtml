@model Models.Empleados
@{
    string cargo = string.Empty;
    if (Model.IntEmpleadoID != 0)
    {
        cargo = Model.Cargos.StrDescripcion;
    }
}

<div class=" container-fluid">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center m-2" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <div class="text-center">

            <img class=" img-fluid img-circle"
                 src="@Model.StrRutaImagen"
                 alt="@Model.StrNombreCompleto">
        </div>

        <h3 class="profile-username text-center">@Model.StrNombreCompleto</h3>

        <p class="text-muted text-center">@cargo</p>

    }

</div>

@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {

    });


</script>



