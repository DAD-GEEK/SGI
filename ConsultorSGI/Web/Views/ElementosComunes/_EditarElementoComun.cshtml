@model Models.ElementosComunes

<input type="hidden" id="elementoComunID" value="@Model.IntElementoComunID" />

<div class=" container-fluid">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center m-2" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <form id="formGuardarGlobal" method="post" action="#">
            @Html.AntiForgeryToken()
            <div class="card card-primary card-outline">

                @Html.Partial("_Card_Titulo", ViewData["Titulo"] = $"{Model.StrDescripcion}")

                <div class="card-body pt-0">

                    <div class="row">

                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="elementoComunDescripcion">Descripción<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    <input class="form-control border-right-0" type="text" id="elementoComunDescripcion" value="@Model.StrDescripcion" placeholder="Ingrese aquí la descripción..." autocomplete="off" maxlength="200" required />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fas fa-tags"></em>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="numeralNormas">Normas<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    @Html.DropDownList("listaNormas", null, null, htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "elementoComunNormas", placeholder = "-- Seleccione una opción", required = "required", Multiple = "Multiple" })
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group  ">
                                <div class="form-group clearfix">
                                    <div class="icheck-primary d-inline">
                                        <input type="checkbox" id="elementoComunActivo" checked="@Model.BitActivo">
                                        <label for="elementoComunActivo">
                                            ¿Activo?
                                        </label>
                                    </div>

                                </div>

                            </div>
                        </div>


                    </div>

                </div>

                @Html.Partial("_Card_Titulo", new ViewDataDictionary { { "titulo", "Numerales" }, { "claseTexto", "d-none" } })

                <div class="card-body pt-1">
                    <div id="divGetElementosComunesDetalle"></div>
                </div>

                @Html.Partial("_Card_Footer")

            </div>
        </form>

    }

</div>

@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {

        $("#btnAtras").click(function () {
            elementosComunesCRUD.getAllElementosComunesAsync();
        });

        elementosComunesDetalleCRUD.ObtenerElementoComunPorIDAsync('@Model.IntElementoComunID');
        elementosComunesCRUD.guardarElementoComunAsync();

    });


</script>



