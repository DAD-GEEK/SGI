
@if (ViewBag.Error != null)
{
    @Html.Partial("_AlertaNovedades", ViewData["error"] = ViewBag.Error)
}
else
{
    <div class="row">

        <div class="col-md-3 col-12">

            <div class="small-box">
                <div class="inner">
                    <h4 class="font-weight-bold">Diagnóstico</h4>

                    <p>Documento diagnóstico @ViewBag.sistemaDeGestion</p>
                </div>
                <div class="icon">
                    <i class="fas fa-cogs text-primary"></i>
                </div>
                <a href="@Url.Action("Index","DocumentosDiagnostico", new { sistemaDeGestion = ViewBag.sistemaDeGestion})" class="small-box-footer bg-primary" id="btnRealizarDiagnosticoInicial">
                    Realizar diagnóstico inicial... <i class="fas fa-arrow-circle-right"></i>

                </a>
            </div>

        </div>
    </div>
}

<script type="text/javascript">

    $(document).ready(function () {


    });

</script>