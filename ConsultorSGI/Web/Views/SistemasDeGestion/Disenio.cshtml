<div class="content-header pt-0 mt-0 pb-1">
    <div class="container-fluid pt-0 mt-0">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="text-dark font-weight-bold">Implementación del sistemas de gestión @ViewBag.sistemaDeGestion</h1>
                <small>Módulo para realizar el diseño y la implementación de los sistemas de gestión de la empresa.</small>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Sistemas de gestión</a></li>
                    <li class="breadcrumb-item active">Diseño</li>
                </ol>
            </div>
        </div>

        <div class="card card-outline card-primary card-sombra">

            @Html.Partial("_Card_Titulo", new ViewDataDictionary { { "titulo", "Diseño general del sistema de gestión" }, { "claseTexto", "d-none" } })

            <div class="card-body">
                <div id="divSistemasDeGestion">

                </div>
            </div>
        </div>
    </div>
</div>



@section BodyArea {
    <div class=" modal fade fade bd-example-modal-sm" id="modal" tabindex="10" role="dialog" aria-hidden="true" data-backdrop="static">
        <div id="contenedor">

        </div>
    </div>
}

@section Scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            sistemasDeGestionCRUD.getInformacionPorSistema('@ViewBag.sistemaDeGestion');

        });

    </script>
}
