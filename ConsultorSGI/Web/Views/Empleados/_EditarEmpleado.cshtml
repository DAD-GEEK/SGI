@model Models.Empleados

<input type="hidden" id="empleadoID" value="@Model.IntEmpleadoID" />
<input type="hidden" id="urlImagenEmpleado" value="@Model.StrRutaImagen" />
<input type="hidden" id="empleadoNombreImagen" value="@ViewBag.nombreImagen" />
<input type="hidden" id="grupoSanguineo" value="@Model.StrGrupoSanguineo" />
<input type="hidden" id="vistaEditar" value="True" />

<div class=" container-fluid">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center m-2" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <form id="formGuardarGlobal" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row">

                <div class="col-md-12">
                    <div class="card card-primary card-outline">

                        <div class="card-header">
                            <ul class="nav nav-pills">
                                <li class="nav-item"><a class="nav-link active" href="#personal" data-toggle="tab">Información personal</a></li>
                                <li class="nav-item"><a class="nav-link" href="#laboral" data-toggle="tab">Información laboral</a></li>
                                <li class="nav-item"><a class="nav-link" href="#medicos" data-toggle="tab">Datos médicos</a></li>
                                <li class="nav-item"><a class="nav-link" href="#contacto" data-toggle="tab">Contacto</a></li>
                                <li class="nav-item"><a class="nav-link" href="#imagen" data-toggle="tab">Imágen</a></li>
                            </ul>
                        </div>

                        <div class="tab-content">

                            @Html.Partial("_Card_Titulo", new ViewDataDictionary { { "titulo", $"{Model.StrIdentificacion} - {Model.StrNombreCompleto}" }, { "claseTexto", "d-none" } })

                            <div class="active tab-pane" id="personal">

                                @Html.Partial("_Card_Titulo", ViewData["Titulo"] = "Datos generales")
                                <div class="card-body pt-1">

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoIdentificacion">Identificación<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 numerico" type="text" id="empleadoIdentificacion" value="@Model.StrIdentificacion" placeholder="Identificación o nit..." autocomplete="off" minlength="6" maxlength="12" required />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-id-card-alt"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoTipoIdentificacion">Tipo identificación<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaTipoIdentificacion", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoTipoIdentificacion", placeholder = "-- Seleccione una opción", required = "required" })
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoPrimerApellido">Primer apellido<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 nombreEmpleado" type="text" id="empleadoPrimerApellido" value="@Model.StrPrimerApellido" placeholder="Primer apellido..." autocomplete="off" maxlength="50" required />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-user-tag"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoSegundoApellido">Segundo apellido</label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 nombreEmpleado" type="text" id="empleadoSegundoApellido" value="@Model.StrSegundoApellido" placeholder="Segundo apellido..." autocomplete="off" maxlength="50" />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-user-tag"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoPrimerNombre">Primer nombre<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 nombreEmpleado" type="text" id="empleadoPrimerNombre" value="@Model.StrPrimerNombre" placeholder="Primer nombre..." autocomplete="off" maxlength="50" required />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-user-tag"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoSegundoNombre">Segundo nombre</label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 nombreEmpleado" type="text" id="empleadoSegundoNombre" value="@Model.StrSegundoNombre" placeholder="Segundo nombre..." autocomplete="off" maxlength="50" />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-user-tag"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>


                                    </div>
                                </div>

                                @Html.Partial("_Card_Titulo", ViewData["Titulo"] = "Ubicación")

                                <div class="card-body pt-0">

                                    <div class="row">

                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoTelefonoFijo">Teléfono</label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0" type="text" id="empleadoTelefonoFijo" value="@Model.StrTelefono" placeholder="Teléfono fijo..." data-inputmask='"mask": "999-9999"' data-mask autocomplete="off" maxlength="20" />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-phone"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoTelefonoMovil">Celular</label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0" type="text" id="empleadoTelefonoMovil" value="@Model.StrCelular" placeholder="Teléfono movil..." data-inputmask='"mask": "999 999-9999"' data-mask autocomplete="off" maxlength="20" required />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-mobile-alt"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoMail">Email</label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0" type="email" name="empleadoMail" id="empleadoMail" value="@Model.StrEmail" placeholder="Email..." autocomplete="off" maxlength="50" />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fa fa-envelope"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoCiudadNacimiento">Ciudad de nacimiento<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaCiudadNacimiento", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoCiudadNacimiento", placeholder = "-- Seleccione una opción", required = "required" })

                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoCiudadResidencia">Ciudad de residencia<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaCiudadResidencia", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoCiudadResidencia", placeholder = "-- Seleccione una opción", required = "required" })

                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoDireccion">Dirección</label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0" type="text" id="empleadoDireccion" value="@Model.StrDireccionResidencia" placeholder="Direccion..." autocomplete="off" maxlength="200" />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fa fa-map-marked-alt"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @Html.Partial("_Card_Titulo", ViewData["Titulo"] = "Otros datos")

                                <div class="card-body pt-0">
                                    <div class="row">

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoFechaNacimiento">Fecha de nacimiento<span class="text-danger">*</span></label>
                                                <div class="input-group with-focus">
                                                    <input class="form-control border-right-0" type="text" id="empleadoFechaNacimiento" value="@Model.DatFechaNacimiento.Value.ToString("yyyy-MM-dd")" placeholder="Fecha nacimiento..." autocomplete="off" required />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-calendar-check"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoEscolaridad">Escolaridad<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaEscolaridad", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoEscolaridad", placeholder = "-- Seleccione una opción", required = "required" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoEstadoCivil">Estado civil<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaEstadoCivil", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoEstadoCivil", placeholder = "-- Seleccione una opción", required = "required" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoEstrato">Estrato social<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaEstratos", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoEstrato", placeholder = "-- Seleccione una opción", required = "required" })

                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoNumeroHijos">Número de hijos</label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 numerico" type="text" id="empleadoNumeroHijos" value="@Model.TIntNumeroHijos" placeholder="Número de hijos..." autocomplete="off" maxlength="1" required />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-sort-numeric-up-alt"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoPersonasACargo">Personas a cargo<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 numerico" type="text" id="empleadoPersonasACargo" value="@Model.StrPersonasACargo" placeholder="Número de personas a cargo..." autocomplete="off" maxlength="1" required />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fas fa-baby"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoNacionalidad">Nacionalidad</label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0" type="text" name="empleadoNacionalidad" id="empleadoNacionalidad" value="@Model.StrNacionalidad" placeholder="Nacionalidad..." autocomplete="off" maxlength="50" />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fab fa-font-awesome-flag"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group clearfix">
                                                <div class="form-group">
                                                    <label class="form-control-label font-weight-bold">Género<span class="text-danger">*</span></label>
                                                    <div class=" input-group with-focus">
                                                        <div class="icheck-primary d-inline">
                                                            @if (Model.StrGenero == "M")
                                                            {
                                                                <input type="radio" id="empleadoGeneroMasculino" name="r1" checked>

                                                            }
                                                            else
                                                            {
                                                                <input type="radio" id="empleadoGeneroMasculino" name="r1">

                                                            }
                                                            <label for="empleadoGeneroMasculino">
                                                                Masculino
                                                            </label>
                                                        </div>

                                                        <div class="icheck-primary d-inline">
                                                            @if (Model.StrGenero == "F")
                                                            {
                                                                <input type="radio" id="empleadoGeneroFemenino" name="r1" checked>

                                                            }
                                                            else
                                                            {
                                                                <input type="radio" id="empleadoGeneroFemenino" name="r1">

                                                            }
                                                            <label for="empleadoGeneroFemenino">
                                                                Femenino
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="form-group  ">
                                                <div class="form-group clearfix">
                                                    <div class="icheck-primary d-inline">
                                                        <input type="checkbox" id="empleadoActivo" checked="@Model.BitActivo">
                                                        <label for="empleadoActivo">
                                                            ¿Activo?
                                                        </label>
                                                    </div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="tab-pane" id="laboral">

                                @Html.Partial("_Card_Titulo", ViewData["Titulo"] = "Empresa")

                                <div class="card-body pt-1">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoArea">Área<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaAreas", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoArea", placeholder = "-- Seleccione una opción", required = "required" })
                                                </div>
                                            </div>
                                        </div>

                                       
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoCentroDeTrabajo">Centro de trabajo<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaCentrosDeTrabajo", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoCentroDeTrabajo", placeholder = "-- Seleccione una opción", required = "required" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoCargo">Cargo<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaCargos", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoCargo", placeholder = "-- Seleccione una opción", required = "required" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoTurno">Turno<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaTurnos", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoTurno", placeholder = "-- Seleccione una opción", required = "required" })

                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoCiudadLaboral">Ciudad donde labora<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaCiudadLaboral", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoCiudadLaboral", placeholder = "-- Seleccione una opción", required = "required" })

                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                @Html.Partial("_Card_Titulo", ViewData["Titulo"] = "Contrato laboral")

                                <div class="card-body pt-0">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoARL">Tipo de contrato<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    @Html.DropDownList("listaTiposContrato", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "select2bs4 form-control ", style = "width: 100%;", id = "empleadoTipoContrato", placeholder = "-- Seleccione una opción", required = "required" })

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoSalario">Salario<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 monedaEU" type="text" id="empleadoSalario" value="@Across.Common.FormatoPesos( Convert.ToInt32( Model.IntSalario))" placeholder="Salario..." autocomplete="off" maxlength="10" required />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <i class="fa fa-dollar-sign"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="empleadoFechaIngreso">Fecha de ingreso<span class="text-danger">*</span></label>
                                                <div class="input-group with-focus">
