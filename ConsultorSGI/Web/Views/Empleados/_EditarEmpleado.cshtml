@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {

        $("#btnAtras").click(function () {
            empleadosCRUD.getAllEmpleadosAsync();
        });

        var urlImagen = $("#urlImagenEmpleado").val();
        var nombreImagen = $("#empleadoNombreImagen").val();

        if ($("#urlImagenEmpleado").val().length != 0) {
            var empleadoImagen = $("#empleadoImagenEditar").fileinput({
                overwriteInitial: true,
                resizeImage: true,
                language: 'es',
                previewClass: 'text-center',
                dropZoneTitle: 'Arrastre o deje caer la imagen del empleado aquí...',
                frameClass: 'block-center',
                maxFileSize: 1000,
                showClose: true,
                showCaption: false,
                browseLabel: 'Agregar imagen',
                removeLabel: 'Remover',
                browseIcon: '<i class="fas fa-plus-circle"></i>',
                removeIcon: '<i class="fas fa-times"></i>',
                removeTitle: 'Cancelar',
                elErrorContainer: '#kv-avatar-errors-1',
                msgErrorClass: 'alert alert-block alert-danger',
                append: true,
                layoutTemplates: {
                    main2: '{preview} {remove} {browse}',
                },
                initialPreview: [
                    urlImagen,
                ],
                initialPreviewAsData: true, // identify if you are sending preview data only and not the raw markup
                initialPreviewFileType: 'image', // image is the default and can be overridden in config below
                initialPreviewDownloadUrl: urlImagen, // includes the dynamic `filename` tag to be replaced for each config
                initialPreviewConfig: [
                    {
                        key: '@Model.IntEmpleadoID',
                        caption: "@Model.StrNombreCompleto",
                        description: "<h5>@Model.StrNombreCompleto</h5> Cargo: @Model.Cargos.StrDescripcion",
                        size: @ViewBag.tamañoImagen,
                        width: "100%",
                        url: rootHost + 'Empleados/EliminarImagenEmpleadoAsync',
                    },
                ],
                allowedFileExtensions: ["jpg", "png", "gif", "jpeg"],
                removeFromPreviewOnError: false, //Remover preview si hay error
                browseOnZoneClick: false, //Abrir buscador al dar click en la imagen
            });
        } else {
            var empleadoImagen = $("#empleadoImagenEditar").fileinput({
                overwriteInitial: true,
                resizeImage: false,
                language: 'es',
                previewClass: 'text-center',
                dropZoneTitle: 'Arrastre o deje caer la imagen del empleado aquí...',
                frameClass: 'block-center',
                maxFileSize: 1000,
                showClose: false,
                showCaption: false,
                browseLabel: 'Agregar imagen',
                removeLabel: 'Remover',
                browseIcon: '<i class="fas fa-plus-circle"></i>',
                removeIcon: '<i class="fas fa-times"></i>',
                removeTitle: 'Cancelar',
                elErrorContainer: '#kv-avatar-errors-1',
                msgErrorClass: 'alert alert-block alert-danger',
                layoutTemplates: { main2: '{preview} {remove} {browse}' },
                allowedFileExtensions: ["jpg", "png", "gif", "jpeg"],
                removeFromPreviewOnError: false, //Remover preview si hay error
                browseOnZoneClick: false, //Abrir buscador al dar click en la imagen
            });
        }

        empleadosCRUD.guardarEmpleadoAsync();
        empleadosCRUD.commonEmpleados();


    });


</script>



