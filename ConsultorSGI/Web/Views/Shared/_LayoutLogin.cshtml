    <!-- Sweet Alert 2 -->
    <script src="@Scripts.Url("~/Vendor/sweetalert2/dist/sweetalert2.js")"></script>

    <!-- Toastr -->
    <script src="@Scripts.Url("~/Vendor/toastr/build/toastr.min.js")"></script>

    <!-- DataTables & Plugins -->
    <script src="@Scripts.Url("~/Vendor/datatables.net/js/jquery.dataTables.min.js")"></script>
    <script src="@Scripts.Url("~/Vendor/datatables.net-bs4/js/dataTables.bootstrap4.min.js")"></script>
    <script src="@Scripts.Url("~/Vendor/datatables.net-responsive/js/dataTables.responsive.min.js")"></script>
    <script src="@Scripts.Url("~/Vendor/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js")"></script>

    <!-- InputMask -->
    <script src="@Scripts.Url("~/Vendor/inputmask/dist/jquery.inputmask.min.js")"></script>

    <!-- Waiting metod -->
    <script src="@Scripts.Url("~/Scripts/propios/waitingDialog.js")"></script>

    <!-- Fileinput -->
    <script src="@Scripts.Url("~/AdminLTE/dist/js/fileinput.min.js")"></script>
    <script src="@Scripts.Url("~/AdminLTE/dist/js/es.js")"></script>

    @*@Scripts.Render("~/bundles/app")*@

    <script src="@Scripts.Url("~/Scripts/app.js")"></script>


    <!-- Login JS -->
    <script src="@Scripts.Url("~/scripts/login/popper.min.js")"></script>
    <script src="@Scripts.Url("~/scripts/login/main.js")"></script>

    @Scripts.Render("~/bundles/app")

    <!-- =============== PAGE VENDOR SCRIPTS ===============-->
    @RenderSection("scripts", required: false)

    <script type="text/javascript">

        var rootHost = "@Scripts.Url("~/")";

        function onAjaxBeginForm() {

            $("body").css("cursor", "progress");
            waitingDialog.show();

        }

        function onAjaxCompleteForm() {

            $("body").css("cursor", "default");
            waitingDialog.hide();
        }

        $(document).ajaxStart(function () {
            onAjaxBeginForm();
        });

        $(document).ajaxStop(function () {
            onAjaxCompleteForm();
        });

        $(window).on('beforeunload', function () {
            $('*').css("cursor", "progress");
            waitingDialog.show();
        });

        setInterval(verifySession, 300000);

        function verifySession() {

            fetch(`${rootHost}Account/VerificarSesionDeUsuario`, {
                method: 'POST'
            })
                .then(res => res.json())
                .then(res => {
                    console.log(res);
                    if (res.msn == "success") {
                    } else {
                        location.href = `${rootHost}Seguridad/Login`
                    }
                })
                .catch(function () {
                    location.href = `${rootHost}Seguridad/Login`
                });

        }


    </script>

</body>
</html>