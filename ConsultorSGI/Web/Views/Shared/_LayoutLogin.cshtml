    <!-- Tempusdominus Bootstrap 4 -->
    <script src="@Scripts.Url("~/Vendor/tempusdominus-bootstrap-4/build/js/tempusdominus-bootstrap-4.min.js")"></script>

    <!-- AdminLTE App -->
