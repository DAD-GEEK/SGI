@using CoreBusiness.Servicios;

@{
    var datosDeUsuario = ServicioUsuarioCoreBusiness.ObtenerDatosDeUsuarioEnSesion;
}

<nav class="main-header navbar navbar-expand navbar-white navbar-light">

    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
    </ul>

    <ul class="navbar-nav ml-auto">
        <li class="nav-item dropdown user-menu">
            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">
                <img src="@datosDeUsuario.UrlImagenDePerfil" class="user-image img-circle elevation-2" alt="User Image">
                <span class="d-none d-md-inline font-weight-bold">@datosDeUsuario.UsuarioNombre <i class="fas fa-sort-down"></i></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-right">

                <li class="user-header fondoOscuroSGI ">
                    <img src="@datosDeUsuario.UrlImagenDePerfil" class="img-circle elevation-1" alt="User Image">

                    <p class="">
                        @datosDeUsuario.Email
                        <small>@datosDeUsuario.TerceroNombre</small>
                        <small>Nit: @datosDeUsuario.TerceroIdentificacion</small>
                    </p>
                </li>
                <!-- Menu Body -->
                @*<li class="user-body">
                        <div class="row">
