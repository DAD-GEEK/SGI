                                <a href="#">Followers</a>
                            </div>
                            <div class="col-4 text-center">
                                <a href="#">Sales</a>
                            </div>
                            <div class="col-4 text-center">
                                <a href="#">Friends</a>
                            </div>
                        </div>
                    </li>*@
                <!-- Menu Footer-->
                <li class="user-footer">
                    @using (Html.BeginForm("CerrarSesion", "Seguridad", FormMethod.Post, new { id = "logoutForm" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6">
                                <a href="@Url.Action("Index", "Manage")" class="btn btn-outline-primary btn-block"><i class="fas fa-user-cog mr-1"></i> Mi Perfil &nbsp;&nbsp; </a>
                            </div>
                            <div class="col-md-6">
                                <a href="javascript:document.getElementById('logoutForm').submit()" class="btn btn-outline-danger btn-block float-right"><i class="fas fa-sign-out-alt mr-1"></i>Cerrar</a>

                            </div>
                        </div>
                    }
