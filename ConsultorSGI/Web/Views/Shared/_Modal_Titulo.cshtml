<div class="modal-header bg-light pt-2 pb-2">
    <p class="modal-title font-weight-bold text-uppercase"><span class=""><i class="@ViewData["icono"] text-primary"></i></span>&nbsp; @ViewData["titulo"]</p>
    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<p class="pt-0 pb-0 mt-0 mb-0 text-sm @ViewData["claseTexto"]" style="padding-left:23px;">Los campos con asterisco (<span class="text-danger">*</span>) son obligatorios. </p>
