@{ 
    var controlador = HttpContext.Current.Session["currentController"];

    if (controlador != null)
    {
        if (controlador.ToString() == "")
        {
            Page.Title = $"Bienvenido a Consultor SGI";
        }
        else
        {
            Page.Title = $"Consultor SGI - {controlador}";
        }
    }
    else
    {
        Page.Title = $"Bienvenido a Consultor SGI";
    }

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <link rel="shortcut icon" href="~/Content/images/SGI.png" class="img-circle" type="image/x-icon" />
    <meta name="keywords" content="app, SGI, Gestion, Integral, Gestion Integral">

    <title>@Page.Title</title>

    <link href="@Styles.Url("https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback")" rel="stylesheet" />
    <link href="@Styles.Url("https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css")" rel="stylesheet" />
    <link href="@Styles.Url("~/Vendor/@fortawesome/fontawesome-free/css/all.min.css")" rel="stylesheet" />
    <link href="@Styles.Url("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.min.css")" rel="stylesheet" />
    <link href="https://unpkg.com/gijgo@1.9.13/css/gijgo.min.css" rel="stylesheet" type="text/css" />

    @Styles.Render("~/bundles/css")

    <script src="@Scripts.Url("~/Vendor/jquery/dist/jquery.min.js")"></script>
    <script src="@Scripts.Url("~/Vendor/jquery-ui-dist/jquery-ui.min.js")"></script>

    @if (IsSectionDefined("Styles"))
    {@RenderSection("Styles", required: false)}

</head>

<body class="sidebar-mini control-sidebar-slide-open sidebar-collapse sidebar-mini-md" style="height:auto;">
    <div class="wrapper">

        <!--Barra superior-->
        @Html.Partial("_TopNavbar")

        <!--Menú lateral -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <div id="divMenu"></div>
        </aside>

        <!--Contenido-->
        <div class="content-wrapper">
            <div class="content">
                @RenderBody()
            </div>
        </div>

        <!--Pie de Página -->
        @Html.Partial("_Footer")

        <!--Barra lateral de Control -->
        @*@Html.Partial("_ControlSidebar")*@

    </div>

    @if (IsSectionDefined("BodyArea"))
    {@RenderSection("BodyArea", required: false)}


    @Scripts.Render("~/bundles/js")
    @Scripts.Render("~/bundles/app")
    <script src="https://unpkg.com/gijgo@1.9.13/js/gijgo.min.js" type="text/javascript"></script>

    <script src="@Scripts.Url("~/Scripts/jquery.signalR-2.4.3.min.js")"></script>
    <script src="~/signalr/hubs" type="text/javascript"></script>

    <!-- =============== PAGE VENDOR SCRIPTS ===============-->
    @RenderSection("scripts", required: false)


    <script type="text/javascript">
        $.widget.bridge('uibutton', $.ui.button)

        var rootHost = "@Scripts.Url("~/")";
        seguridad.getMenuDinamicoAsync();

        var contador = 0;
        var userActivity = $.connection.trackingOnlineUsers;

        userActivity.client.online = function (signalRUsers) {

            $('#tblListaUsuariosOnline tbody > tr').remove();
            contador = 0;

            for (var i in signalRUsers) {
                contador++;
                $("#tblListaUsuariosOnline tbody").append(`
                        <tr>
                            <td class="text-left font-weight-bold">
                                <img class="img-responsive img-circle img-thumbnail" style="width:40px; height:40px;" src="${signalRUsers[i].Image}" alt="${signalRUsers[i].UserName}" />
                                ${signalRUsers[i].UserName} <span class="badge badge-success">ONLINE</span>

                            </td>
                            <td>${signalRUsers[i].Email}</td>
                            <td>${signalRUsers[i].TerceroNombre}</td>
                            <td class='text-center'>${signalRUsers[i].FechaConectado}</td>

                        </tr>
                    `);
            }

            $("#lblCantidad").text(contador);
        };

        $.connection.hub.start();

        var Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000
        });

        function onAjaxBeginForm() {
            $("body").css("cursor", "progress");
            waitingDialog.show();
        }

        function onAjaxCompleteForm() {

            $("body").css("cursor", "default");
            waitingDialog.hide();
        }

        $(document).ajaxStart(function () {
            onAjaxBeginForm();
        });

        $(document).ajaxStop(function () {
            onAjaxCompleteForm();
        });

        $(window).on('beforeunload', function () {
            $('*').css("cursor", "progress");
            waitingDialog.show();
        });

        setInterval(verifySession, 300000);

        function verifySession() {

            fetch(`${rootHost}Account/VerificarSesionDeUsuario`, {
                method: 'POST'
            })
                .then(res => res.json())
                .then(res => {
                    if (res.msn == "success") {
                    } else {
                        location.href = `${rootHost}Seguridad/Login`
                    }
                })
                .catch(function () {
                    location.href = `${rootHost}Seguridad/Login`
                });

        }

    </script>

</body>
</html>