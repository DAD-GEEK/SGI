@using Across;
@using CoreBusiness;

@model Models.DTO.InformeAuditoriaDTO

@*<link href="@Styles.Url("~/Vendor/@fortawesome/fontawesome-free/css/all.min.css")" rel="stylesheet" />*@

@{
    string rutaIconos = "~/Vendor/@fortawesome/fontawesome-free/css/all.min.css";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>

<style type="text/css">

    .letraMediana {
        font-size: 13px;
        line-height: 17px;
    }

    h6.titulo {
        display: inline-block;
        position: relative;
    }

        h6.titulo::after {
            content: '';
            position: absolute;
            width: 60px;
            height: 2px;
            background-color: #007bff;
            top: 1.3em;
            left: 0px;
        }

        h6.titulo::before {
            content: '';
            position: absolute;
            width: 10px;
            height: 2px;
            background-color: #007bff;
            top: 1.3em;
            left: 65px;
        }


    :root {
        --card-color: rgba(54, 0, 204, 0.555);
        --card-header-color: crimson;
        --card-body-color: rgb(40, 4, 124);
        --card-footer-color: indigo;
    }

    text-primary {
        color: #007bff !important;
    }

    .card-primary.card-outline {
        border-top: 3px solid #007bff;
    }

    .card-sombra {
        box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;
    }

    .card {
        margin: 0 auto;
        background: var(--card-color);
        color: #6c757d;
        width: 100%;
        padding: 20px;
        border-radius: 20px;
        word-wrap: break-word;
    }

    .card-header {
        background-color: transparent;
        padding: 0.75rem 1.25rem;
        position: relative;
        border-top-left-radius: 0.25rem;
        border-top-right-radius: 0.25rem;
        border-bottom: none
    }

    .card-body {
        -webkit-flex: 1 1 auto;
        -ms-flex: 1 1 auto;
        flex: 1 1 auto;
        min-height: 1px;
        padding: 1.25rem;
    }

    .marcaDeAgua {
        /* the image you want to 'watermark' */
        height: 300px; /* or whatever, equal to the image you want 'watermarked' */
        width: 100%; /* as above */
        background-repeat: repeat;
        position: absolute;
        opacity: 0.08;
        top: 250px;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

    thead {
        display: table-header-group;
    }

    tbody {
        display: table-row-group;
    }

    tfoot {
        display: table-row-group
    }

    .firmas {
        page-break-inside: avoid;
    }
</style>

@{
    var urlImagen = Archivos.GetUrlImagenTerceroOrUrlDefault(Model.Auditoria.Terceros_Clientes.StrRutaImagen);

    string fechaDeVersion = string.Empty;

    if (!string.IsNullOrEmpty(Model.Auditoria.DatFechaVersion.ToString()))
    {
        fechaDeVersion = Model.Auditoria.DatFechaVersion.Value.ToString("yyyy-MM-dd");
    }

    var listaAuditados = new List<string>();
    var listaAuditores = new List<string>();

    foreach (var item in Model.Auditoria.AuditoriasDetalle)
    {
        var listaNombresAuditados = item.StrAuditado.Trim().Split(',');
        var listaNombresAuditores = item.StrAuditor.Trim().Split(',');

        foreach (var nombre in listaNombresAuditados.Distinct())
        {
            listaAuditados.Add(nombre.Trim());
        }

        foreach (var nombre in listaNombresAuditores.Distinct())
        {
            listaAuditores.Add(nombre.Trim());
        }
    }
}

<div class="container-fluid">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center m-2" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <div>
            <div class="card-body" style="padding-top:0px;padding-bottom:10px;margin-top:0px;">

                <div class="text-muted letraMediana float-right">
                    @if (!string.IsNullOrEmpty(Model.Auditoria.StrVersion))
                    {
                        <span class="font-weight-bold">Versión documento: </span>@Model.Auditoria.StrVersion<span> | </span>
                    }

                    @if (!string.IsNullOrEmpty(fechaDeVersion))
                    {
                        <span class="font-weight-bold">Fecha de versión: </span>@fechaDeVersion <span> | </span>
                    }

                    @if (!string.IsNullOrEmpty(Model.Auditoria.StrCodigo))
                    {
                        <span class="font-weight-bold"> | Código de documento: </span>@Model.Auditoria.StrCodigo
                    }

                </div>

                <table style="width:100%" class="letraMediana text-muted p-0 m-0">
                    <tr>
                        <td style="width:15%">
                            <div class="text-center">
                                <img class=" img-circle"
                                     src="@urlImagen"
                                     style="width:100%!important; margin:auto!important;max-height:300px;"
                                     alt="Logo @Model.Auditoria.Terceros_Clientes.StrNombre.ToLower()">
                            </div>
                        </td>

                        <td style="width:45%;padding-left:20px;">
                            <h6 class="font-weight-bold mb-0 text-black">@Model.Auditoria.Terceros_Clientes.StrNombre</h6>
                            <p class="pt-0 mt-0 mb-0 text-sm">Nit: @Model.Auditoria.Terceros_Clientes.StrIdentificacion</p>
                            <p class="pt-0 mt-0 mb-0 text-sm">Dirección: @Model.Auditoria.Terceros_Clientes.StrDireccion</p>
                            <p class="pt-0 mt-0 mb-0 text-sm">Telefóno: @Model.Auditoria.Terceros_Clientes.StrTelefono</p>
                            <p class="pt-0 mt-0 mb-0 text-sm">Email: @Model.Auditoria.Terceros_Clientes.StrEmail</p>
                        </td>

                        <td style="width:30%; text-align:left;">
                            <p class="">
                                <b class="d-block text-uppercase">Fecha auditoría</b>
                                @Model.Auditoria.DatFechaInicial.ToString("dd MMMM ' del ' yyyy") <br />

                                @if (Model.Auditoria.DatFechaElaboracionInforme != null)
                                {
                                    <b class="d-block text-uppercase">Fecha informe</b>
                                    @Model.Auditoria.DatFechaElaboracionInforme.Value.ToString("dd MMMM ' del ' yyyy")
                                }
                            </p>
                        </td>

                        <td style="width:10%">
                            <h1 class="text-danger font-weight-bold text-left">@Model.Auditoria.IntConsecutivo</h1>
                        </td>
                    </tr>
                </table>

            </div>
        </div>

        <div class="marcaDeAgua">
            <img src="https://app.gestionintegralsgi.com.co/Content/images/logo.png" style="width:100%" alt="logo SGI" />
        </div>

        <div class="text-muted pt-2 letraMediana ">

            <div class="row">

                <div class="col-6">
                    <div class="card card-outline card-primary card-sombra letraMediana">
                        <div class="card-header pb-0 pt-0">
                            <h6 class="titulo font-weight-bold">OBJETIVO</h6>
                        </div>
                        <div class="card-body pt-0 pb-0 text-justify">
                            <p>@Model.Auditoria.StrObjetivo</p>
                        </div>

                    </div>
                </div>

                <div class="col-6">
                    <div class="card card-outline card-primary card-sombra letraMediana">
                        <div class="card-header pb-0 pt-0">
                            <h6 class="titulo font-weight-bold">ALCANCE</h6>
                        </div>
                        <div class="card-body pt-0 pb-0 text-justify">
                            <p>@Model.Auditoria.StrAlcance</p>
                        </div>

                    </div>
                </div>

            </div>

        </div>

        <div class="text-muted pt-2 letraMediana">

            <div class="row">
                <div class="col-6 pl-0">

                    <div class="card-header pb-0">
                        <h6 class="font-weight-bold titulo">AUDITADOS</h6>
                    </div>

                    <div class="card-body pt-0">

                        @{
                            foreach (var auditado in listaAuditados.Distinct().OrderBy(x => x))
                            {
                                <p class="pt-0 mt-0 pb-0 mb-0 text-sm text-muted">- @auditado</p>
                            }
                        }
                    </div>
                </div>

                <div class="col-6 pl-0">

                    <div class="card-header pb-0">
                        <h6 class="font-weight-bold titulo">AUDITORES</h6>
                    </div>

                    <div class="card-body pt-0">

                        @{

                            foreach (var auditor in listaAuditores.Distinct().OrderBy(x => x))
                            {
                                <p class="pt-0 mt-0 pb-0 mb-0 text-sm text-muted">
                                    - @auditor
                                </p>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="text-muted pt-2 letraMediana">

            <div class="row">
                <div class="col-12 pl-0">

                    <div class="card-header pb-0">
                        <h6 class="font-weight-bold titulo">CRITERIOS DE LA NORMA</h6>
                    </div>

                    <div class="card-body pt-0">

                        @foreach (var norma in Model.Auditoria.Auditorias_Normas)
                        {
                            <p class="pt-0 mt-0 pb-0 mb-0 text-muted"><i class="fas fa-check text-primary pr-2" style="font-size:8px;"></i><span class="font-weight-bold font-italic">@norma.Normas.StrCodigo: </span> @norma.Normas.StrDescripcion </p>
                        }

                    </div>


                </div>

            </div>
        </div>

        <div class="text-muted pt-2 letraMediana">

            <div class="row">
                <div class="col-12 pl-0">
                    <div class=" letraMediana">
                        <div class="card-header pb-0 pt-0">
                            <h6 class="titulo font-weight-bold">FORTALEZAS</h6>
                        </div>
                        <div class="card-body pt-0 pb-0 text-justify">

                            @if (!string.IsNullOrEmpty(Model.Auditoria.StrFortalezas))
                            {
                                var arrayFortalezas = Model.Auditoria.StrFortalezas.Split('.');

                                foreach (var item in arrayFortalezas)
                                {
                                    @item<span>.</span>
                                    <br />
                                }
                            }

                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="text-muted pt-2 letraMediana pl-0">

            <div class="row">
                <div class="col-12 pb-1 pl-0">

                    <div class="card-header pb-0">
                        <h6 class="font-weight-bold titulo">REPORTE DE HALLAZGOS</h6>
                    </div>

                    <div class="card-body pt-0 pb-0">
                        <table id="tblNoConformidades" class="table dt-responsive table-condensed table-sm center-block mt-2 text-sm text-muted letraMediana" style="width:100%">

                            <tr class="text-center card-sombra" style="border-radius: 10px; background-color: #eae8e8">
                                <th class="text-left">Numerales</th>
                                <th class="text-left">Hallazgo</th>
                                <th class="text-center">Clasificación</th>
                            </tr>

                            <tbody class="text-sm text-muted">

                                @foreach (var proceso in Model.NoConformidades.GroupBy(x => x.ProcesoDescripcion))
                                {
                                    <tr class="listasVerificacion">
                                        <td colspan="3">
                                            <h5 class="font-weight-bold text-uppercase mt-2 mb-0">@proceso.Key</h5>
                                        </td>
                                    </tr>

                                    foreach (var item in Model.NoConformidades.Where(x => x.ProcesoDescripcion == proceso.Key).OrderBy(x => x.Orden))
                                    {
                                        <tr>
                                            <td class="text-left">

                                                @Html.Partial("_NumeralesPorNorma", item.NormasDTO.ToList())

                                            </td>

                                            <td class="text-left">

                                                <h6 class="font-weight-bold text-primary">@item.Titulo</h6>

                                                @if (item.FechaQueSeAudita != null)
                                                {
                                                    <b class="text-secondary font-weight-bold"><i class="fas fa-calendar-check mr-1"></i> Fecha en que se audita: </b> @Across.Common.ObtenerFechaLarga(item.FechaQueSeAudita.Value)
                                                }

                                                <hr class="m-1" />

                                                @if (ViewBag.isVistaInforme)
                                                {
                                                    <p class="cajaTexto text-justify">@item.HallazgoInforme</p>
                                                }
                                                else
                                                {
                                                    <p class="cajaTexto text-justify">@item.Hallazgo</p>
                                                }

                                            </td>

                                            @if (item.NoConformidad)
                                            {
                                                <td class="text-center"><span class="badge badge-danger">NO CONFORMIDAD</span></td>
                                            }
                                            else
                                            {
                                                <td class="text-center"><span class="badge badge-warning">OBSERVACIÓN</span></td>

                                            }

                                        </tr>
                                    }
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    @{
                                        List<Models.DTO.NormasDTO> listaCantidadNormas = Model.ListaNormasDTO;
                                        Html.RenderPartial("_CantidadNoConformidadesPorNorma", listaCantidadNormas);
                                    }
                            </tfoot>
                        </table>
                    </div>


                </div>

            </div>
        </div>


        <div class="text-muted pt-4 letraMediana">

            <div class="row">
                <div class="col-12 pl-0">
                    <div class="card-header pb-0 pt-0">
                        <h6 class="titulo font-weight-bold">CONCLUSIONES</h6>
                    </div>
                    <div class="card-body pt-0 pb-0 text-justify">

                        @if (!string.IsNullOrEmpty(Model.Auditoria.StrConclusiones))
                        {
                            var arrayConclusiones = Model.Auditoria.StrConclusiones.Split('.');

                            foreach (var item in arrayConclusiones)
                            {
                                @item<span>.</span>
                                <br />
                            }
                        }


                    </div>
                </div>

            </div>
        </div>

        <div class="text-muted letraMediana firmas" style="padding-top:100px">

            <div class="row">
                <div class="col-6">
                    @if (!string.IsNullOrEmpty(Model.Usuario.NombreImagenFirma) && (bool)Model.Auditoria.BitFirma)
                    {
                        var urlFirma = Archivos.GetUrlImagenUsuarioFirma(Model.Usuario.NombreImagenFirma);

                        if (!string.IsNullOrEmpty(urlFirma))
                        {
                            <img src="@urlFirma" class="img align-content-lg-around" style="height:100px; width:100%" alt="Alternate Text" />
                        }
                    }

                </div>

                <div class="col-6"></div>
            </div>

            <div class="row">

                <div class="col-6">

                    <div class="border-top">
                        <span class="font-weight-bold">@Model.Usuario.NombreUsuario</span>
                        <p class="mt-0 mb-0 pt-0 pb-0">AUDITOR PRINCIPAL</p>
                        <p class="mt-0 mb-0 pt-0 pb-0">@Empresa.RazonSocial</p>
                        <p class="mt-0 mb-0 pt-0 pb-0">NIT: @Empresa.Nit</p>
                        <br />
                    </div>

                </div>

                <div class="col-6">

                    <div class="border-top">
                        <span class="font-weight-bold">@Model.Auditoria.Terceros_Clientes.StrRepresentanteLegal.ToUpper()</span>
                        <p class="mt-0 mb-0">REPRESENTANTE LEGAL</p>
                        <p class="mt-0 mb-0">@Model.Auditoria.Terceros_Clientes.StrNombre</p>
                        <p class="mt-0 mb-0">NIT: @Model.Auditoria.Terceros_Clientes.StrIdentificacion</p>
                        <br />
                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-6" style="margin-top: 120px;">

                    <div class="border-top">
                        <span class="font-weight-bold">@Model.Auditoria.StrIntegranteCopasst.ToUpper()</span>
                        <p class="mt-0 mb-0 pt-0 pb-0">INTEGRANTE DEL COPASST / VIGÍA</p>
                        <p class="mt-0 mb-0">@Model.Auditoria.Terceros_Clientes.StrNombre</p>
                        <p class="mt-0 mb-0">NIT: @Model.Auditoria.Terceros_Clientes.StrIdentificacion</p>
                        <br />
                    </div>

                </div>

                <div class="col-6">



                </div>

            </div>
        </div>


    }

</div>

<script type="text/javascript">

    $(document).ready(function () {

        $("#tblNoConformidades > tbody > tr").each(function (i, item) {

            var texto = $(item).find(".cajaTexto").html();
            if (typeof texto != 'undefined')
                $(item).find(".cajaTexto").html(texto.replace(/\n/g, '<br \\>'));

        });

    });



</script>



