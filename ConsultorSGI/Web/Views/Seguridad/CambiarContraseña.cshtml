@model Web.Models.ResetPasswordViewModel

@{
    Layout = "~/Views/Shared/_LayoutRegister.cshtml";
}

<input type="hidden" id="registroCode" value="@Model.Code" />
<input type="hidden" id="registroEmail" value="@Model.Email" />


<div class="fondoRegistro"></div>
<div class="register-box">
    <div class="card card-outline card-primary">
        @Html.Partial("_Card_Titulo_Login")
        <div class="card-body pt-1">
            <p class="login-box-msg">Restablecer su contraseña</p>

            <form id="formCambiarContraseña">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <div class="input-group with-focus">
                        <input class="form-control border-right-0" type="password" id="registroClave" placeholder="Ingrese aquí su nueva contraseña..." autocomplete="off" minlength="5" maxlength="20" required="required" />
                        <div class="input-group-append">
                            <span class="input-group-text text-muted bg-transparent border-left-0">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input class="form-control border-right-0" type="password" id="registroConfirmarClave" placeholder="Ingrese aquí la confirmación de su contraseña..." autocomplete="off" minlength="5" maxlength="20" required="required" />
                        <div class="input-group-append">
                            <span class="input-group-text text-muted bg-transparent border-left-0">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary btn-block"><i class="fa fa-lock mr-1"></i>Cambiar contraseña</button>
                    </div>

                </div>
            </form>

        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        seguridad.cambiarContraseñaAsync();
    });

</script>

