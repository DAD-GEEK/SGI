@using CoreBusiness;
@model List<Models.DTO.TercerosUsuariosDTO>

@{
    string Estado = string.Empty;
}

<div class="card-header fondoOscuroSGI">

    <div class="row">
        <div class="col-md-3">
            <button type="button" class="btn btn-outline-light btn-block" data-toggle="modal" id="btnCrearUsuario"><i class="fas fa-user-plus"></i>&nbsp;&nbsp;Agregar usuario</button>
        </div>
    </div>

</div>

<div class="card-body border">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        @Html.AntiForgeryToken()
        <table id="tblUsuariosTerceros" class="table table-bordered dt-responsive table-sm center-block dataTableTerceros text-sm" style="width:100%">
            <thead class="text-center text-white fondoColorSGI">
                <tr>
                    <th style="display:none;">UsuarioID</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Tercero</th>
                    <th class="text-center">Estado registro</th>
                    <th class="text-center">Email confirmado</th>
                    <th class="text-center">Estado usuario</th>
                    <th>Fecha de registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td style="display:none;"> @item.IntRegistroID</td>
                        <td>@item.StrUsuarioNombre</td>
                        <td>@item.StrUsuarioEmail</td>
                        @{
                            var urlImagen = Archivos.GetUrlImagenTerceroOrUrlDefault(item.StrNombreImagen);
                            <td> <img class="img-responsive img-circle img-thumbnail" style="width:40px; height:40px;" src="@urlImagen" alt="Logo" />&nbsp; @item.StrTerceroNombre</td>
                        }


                        @if (item.BitRegistrado == true)
                        {
                            <td class="text-center"><span class="badge badge-success">REGISTRADO</span></td>
                        }
                        else
                        {
                            <td class="text-center"><span class="badge badge-danger">SIN REGISTRAR</span></td>
                        }

                        @if (item.StrEmailConfirmado == true)
                        {
                            <td class="text-center"><span class="badge badge-success">CONFIRMADO</span></td>
                        }
                        else
                        {
                            <td class="text-center"><span class="badge badge-danger">SIN CONFIRMAR</span></td>
                        }

                        @if (item.OpcEstado == true)
                        {
                            <td class="text-center"><span class="badge badge-success">ACTIVO</span></td>
                        }
                        else
                        {
                            <td class="text-center"><span class="badge badge-danger">INACTIVO</span></td>
                        }

                        <td class="text-center">@item.StrFechaIngreso</td>

                        <td class=" text-center">
                            <button type="button" title="Editar usuario" data-toggle="tooltip" data-placement="left" class="btn btn-outline-dark btn-sm glyphicon glyphicon-edit" data-registroid="@item.IntRegistroID" data-tipoevento="editar"><i class="fa fa-edit fa-fw"></i></button>
                            <button type="button" title="Eliminar usuario" data-toggle="tooltip" data-placement="left" class="btn btn-outline-danger btn-sm glyphicon glyphicon-trash" data-registroid="@item.IntRegistroID" data-tipoevento="eliminar"><i class="fa fa-trash fa-fw"></i></button>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    }
</div>

<script type="text/javascript">

    $(document).ready(function () {

        var btnCrearUsuario = $("#btnCrearUsuario");
        btnCrearUsuario.click(function () {
            seguridad.crearUsuario();
        });

        var tblUsuariosTerceros = $('#tblUsuariosTerceros').DataTable({

            "order": [[2, "desc"]],
            "columnDefs": [
                {
                    "targets": [0],
                    "visible": false,
                    "searchable": false
                }],
            "language": {
                "sProcessing": "Procesando...",
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "Ningún dato disponible en esta tabla",
                "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                "sInfoPostFix": "",
                "sSearch": "Buscar:",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Cargando...",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Último",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                },
                "oAria": {
                    "sSortAscending": ": Activar para ordenar la columna de manera ascendente",
                    "sSortDescending": ": Activar para ordenar la columna de manera descendente"
                }
            },

            "lengthMenu": [[10, 20, 50, 100], [10, 20, 50, 100]]
        });

        $('#tblUsuariosTerceros tbody').on('click', 'button', function () {

            var tipoEvento = $(this).data("tipoevento");
            var registroID = $(this).data("registroid");

            if (tipoEvento == 'editar') return seguridad.getUsuarioByEditarAsync(registroID);
            if (tipoEvento == 'eliminar') return seguridad.deleteUsuarioAsync(registroID);

        });

    });


</script>



