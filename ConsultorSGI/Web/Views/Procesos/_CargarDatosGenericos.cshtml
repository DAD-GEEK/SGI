@model List<Models.Procesos>

@{
    Layout = null;
}

<input type="hidden" id="procesoID" value="@ViewBag.procesoID" />
<input type="hidden" id="procesoDescripcion" value="@ViewBag.procesoDescripcion" />

<div class="modal-dialog " style=" max-width: 900px !important;">
    <div class="modal-content card card-outline card-primary ">

        @Html.Partial("_Modal_Titulo", new ViewDataDictionary { { "titulo", "Procesos genéricos" }, { "icono", "fa fa-cogs" }, { "claseTexto", "d-none" } })

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger block-center m-2" role="alert">
                @ViewBag.Error
            </div>
        }
        else
        {
            <div class="modal-body pt-3" style="overflow-y: auto!important; max-height: 80vh !important;">
                <div class="container-fluid">

                    <table id="tblProcesosGlobal" class="table dt-responsive table-sm center-block text-sm" style="width:100%">
                        @Html.AntiForgeryToken()
                        <thead class="text-center text-white fondoColorSGI">
                            <tr>
                                <th>Id</th>
                                <th class="text-center">Codigo</th>
                                <th>Descripción</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.IntProcesoID</td>

                                    <td class="text-center font-weight-bold h6">@item.StrCodigo</td>

                                    <td>@item.StrDescripcion <span class="badge badge-pill badge-warning font-weight-bold">Genérico</span></td>

                                    <td class=" text-center">
                                        <button type="button" title="Copiar las listas de verificación del proceso genérico @item.StrDescripcion en el proceso @ViewBag.procesoDescripcion" data-toggle="tooltip" data-placement="left" class="btn btn-outline-dark btn-sm glyphicon glyphicon-edit" data-registroid="@item.IntProcesoID" data-genericonombre="@item.StrDescripcion" data-tipoevento="agregar"><i class="fa fa-copy fa-fw mr-2"></i>Copiar listas de verificación</button>
                                    </td>

                                </tr>
                            }

                        </tbody>
                    </table>

                </div>
            </div>

            <div class="modal-footer bg-light">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">

                        </div>

                        <div class="col-md-6">
                            <div class="row">

                                <div class="col-xs-12 col-md-6">
                                </div>

                                <div class="col-xs-12 col-md-6">
                                    <button type="button" data-dismiss="modal" class="btn btn-block btn-outline-dark"><i class="fas fa-undo-alt mr-1"></i>Cancelar</button>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>


        }

    </div>
</div>

@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {

        var tblProcesosGlobal = $('#tblProcesosGlobal').DataTable({
            "order": [[1, "asc"]],
            "searching": true,
            "ordering": true,
            //"paging": false,
            "columnDefs": [
                {
                    "targets": [0],
                    "visible": false,
                    "searchable": false
                }],
            "language": {
                "sProcessing": "Procesando...",
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "Ningún dato disponible en esta tabla",
                "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                "sInfoPostFix": "",
                "sSearch": "Buscar:",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Cargando...",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Último",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                },
                "oAria": {
                    "sSortAscending": ": Activar para ordenar la columna de manera ascendente",
                    "sSortDescending": ": Activar para ordenar la columna de manera descendente"
                }
            },

            "lengthMenu": [[10, 20, 50, 100], [10, 20, 50, 100]]
        });

        $('#tblProcesosGlobal tbody').on('click', 'button', function () {

            var tipoEvento = $(this).data("tipoevento");
            var registroID = $(this).data("registroid");
            var procesoGenericoDescripcion = $(this).data("genericonombre");


            var procesoGenericoID = registroID;
            var procesoActual = $("#procesoID").val();

            if (tipoEvento == 'agregar')
                return procesosCRUD.cargarDatosDeProcesoGlobalAsync(procesoGenericoID, procesoGenericoDescripcion, procesoActual);

        });

    });


</script>



