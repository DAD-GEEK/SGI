@model Web.Models.ResetPasswordViewModel

@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="fondoRegistro"></div>
<div class="register-box">
    <div class="card card-outline card-primary">
        <div class="card-header text-center">
            <a href="@Url.Action("Login","Account")" class="h1">Consultor<b class="text-primary ">SGI</b></a>
        </div>
        <div class="card-body">
            <p class="login-box-msg">Restablecer su contraseña</p>

            @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "formCambiarContraseña" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Code)
                <div class="form-group">
                    <div class="input-group with-focus">
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-right-0", type = "email", id = "registroEmail", placeholder = "Email...", autocomplete = "off", required = "required" })
                        <div class="input-group-append">
                            <span class="input-group-text text-muted bg-transparent border-left-0">
                                <i class="fa fa-envelope"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="input-group with-focus">
                        @Html.TextBoxFor(m => m.Password, new { @class = "form-control border-right-0", type = "password", id = "registroClave", placeholder = "Nueva contraseña de acceso...", autocomplete = "off", minlength = "5", maxlength = "20", required = "required" })
                        <div class="input-group-append">
                            <span class="input-group-text text-muted bg-transparent border-left-0">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control border-right-0", type = "password", id = "registroConfirmarContraseña", placeholder = "Confirmar nueva contraseña...", autocomplete = "off", minlength = "5", maxlength = "20", required = "required" })
                        <div class="input-group-append">
                            <span class="input-group-text text-muted bg-transparent border-left-0">
                                <i class="fas fa-lock"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-block btnRegistrar"><i class="fa fa-lock mr-1"></i>Cambiar contraseña</button>
                    </div>
                    <div class="col-12">
                        <div class="card card-primary d-none m-0 p-0 btnProcesar">
                            <div class="card-header rounded m-0 p-0">

                                <div class="card-tools">
                                    <button type="button" class="btn btn-block text-center font-weight-bold " data-source="widgets.html" data-card-widget="card-refresh" data-source-selector="#card-refresh-content">
                                        &nbsp;
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        @Html.ValidationSummary("", new { @class = "text-danger" })
                        @if (ViewBag.ErrorRegistro != null)
                        {
                            <ul class="text-danger ">
                                <li> @ViewBag.ErrorRegistro </li>
                            </ul>
                        }

                        <div class="description">
                            <p class="font-weight-bold text-center text-danger">@ViewBag.RevisarEmail</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- /.form-box -->
    </div><!-- /.card -->
</div>

<script src="@Scripts.Url("~/Vendor/jquery/jquery.min.js")"></script>
<script src="@Scripts.Url("~/Scripts/common/parsley.js")"></script>
<script src="@Scripts.Url("~/Scripts/modulos/Funciones_Globales/parsleyValidationsForms.js")"></script>
<script src="@Scripts.Url("~/Scripts/modulos/Funciones_Globales/parsleyValidationsForms.js")"></script>

<script type="text/javascript">
    $(document).ready(function () {


        var formularioLogin = $("#formCambiarContraseña");
        var btnIngresar = $(".btnRegistrar");
        var btnProcesar = $(".btnProcesar");

        formularioLogin.submit(function () {

            btnIngresar.addClass('d-none');
            btnProcesar.removeClass('d-none');

        });
    });

</script>




