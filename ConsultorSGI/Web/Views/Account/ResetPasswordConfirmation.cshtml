@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="fondoRegistro"></div>
<div class="register-box">
    <div class="card card-outline card-primary">
        <div class="card-header text-center">
            <a href="@Url.Action("Login","Account")" class="h1">Consultor<b class="text-primary ">SGI</b></a>
        </div>
        <div class="card-body">
            <p class="login-box-msg">Su contraseña fue restablecida exitosamente.</p>

            <div class="row">
                <div class="col-md-12">
                    <a href="@Url.Action("Login","Account")" class="btn btn-block btn-primary">
                        <i class="fas fa-sign-in-alt mr-1"></i>
                        Ir a consultorSGI
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="@Scripts.Url("~/Vendor/jquery/jquery.min.js")"></script>



