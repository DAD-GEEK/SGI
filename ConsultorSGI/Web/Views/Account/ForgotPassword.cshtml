@model Web.Models.ForgotPasswordViewModel

@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<div class="fondoRegistro"></div>
<div class="register-box">
    <div class="card card-outline card-primary">
        <div class="card-header text-center">
            <a href="@Url.Action("Login","Account")" class="h1">Consultor<b class="text-primary ">SGI</b></a>
        </div>
        <div class="card-body">
            <p class="login-box-msg">Ingrese su correo electróinco para recuperar la contraseña.</p>

            @using (Html.BeginForm("ForgotPassword", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "formRecuperarContraseña" }))
            {
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="input-group with-focus mb-3">
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-right-0 validarParsley", type = "email", placeholder = "Email...", autocomplete = "off", required = "required", id = "inputEmailRecuperarContraseña"})
                                <div class="input-group-append">
                                    <span class="input-group-text text-muted bg-transparent border-left-0">
                                        <i class="fa fa-envelope"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <button type="button" id="btnRecuperarContraseña" class="btn btn-block btn-primary">
                            <i class="fas fa-lock-open mr-1"></i>
                            Recuperar contraseña
                        </button>
                    </div>

                    <div class="col-md-12">
                        <div class="card card-primary m-0 p-0 d-none  btnProcesarRecuperar">
                            <div class="card-header rounded m-0 p-0">

                                <div class="card-tools">
                                    <button type="button" class="btn btn-block text-center font-weight-bold " data-source="widgets.html" data-card-widget="card-refresh" data-source-selector="#card-refresh-content">
                                        &nbsp;
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>


                    <div class="col-md-12">
                        <div class="description">
                            <p class="font-weight-bold text-center text-danger" id="confirmacionRevisarMail">@ViewBag.RevisarEmail</p>
                        </div>
                        @ViewBag.ErrorAutenticacion
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    </div>
                </div>
            }


        </div>
    </div><!-- /.card -->
</div>


<script src="@Scripts.Url("~/Vendor/jquery/jquery.min.js")"></script>
<script src="@Scripts.Url("~/Scripts/common/parsley.js")"></script>
<script src="@Scripts.Url("~/Scripts/modulos/Funciones_Globales/parsleyValidationsForms.js")"></script>
<script src="@Scripts.Url("~/Scripts/modulos/Funciones_Globales/parsleyValidationsForms.js")"></script>


<script type="text/javascript">
    $(document).ready(function () {

        $("input").parsley();

        var formRecuperarContraseña = $("#formRecuperarContraseña");
        var btnRecuperarContraseña = $("#btnRecuperarContraseña");
        var inputEmail = $("#inputEmailRecuperarContraseña");

        btnRecuperarContraseña.click(function () {

            inputEmail.parsley().validate();

            if (inputEmail.parsley().isValid()) {
                formRecuperarContraseña.submit();
            }
        });

        var btnRecuperar = $(".btnProcesarRecuperar");

        formRecuperarContraseña.submit(function () {
            btnRecuperarContraseña.addClass('d-none');
            btnRecuperar.removeClass('d-none');
        });


    });

</script>
