@model List<Models.AspNetTerceroRoles>

<div class="card-header fondoOscuroSGI card-no-radius">

    <div class="row">
        <div class="col-md-3">
            <button type="button" class="btn btn-outline-light btn-block" id="btnAgregarRol"><i class="fas fa-user-lock mr-2"></i>Asignar módulo</button>
        </div>
    </div>

</div>

@Html.Partial("_Modal_Titulo", new ViewDataDictionary { { "titulo", $"Módulos con acceso" }, { "icono", "fa fa-user-plus" }, { "claseTexto", "d-none" } })

<div class="card-body pt-1">

    <table id="tblAuditorias" class="table dt-responsive table-condensed table-sm center-block" style="width:100%">
        @Html.AntiForgeryToken()
        <thead class="text-center" style="border-radius:10px">
            <tr>
                <th style="display:none">Id</th>
                <th class="text-left">Módulo</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="display:none">@item.IntRolID</td>
                    <td class="text-left" style="width:80%">@item.AspNetRoles.Name</td>
                    <td class=" text-center" style="width:20%!important">
                        <button type="button" title="Eliminar módulo" data-toggle="tooltip" data-placement="left" class="btn btn-outline-danger btn-sm  glyphicon glyphicon-edit" onclick="tercerosCRUD.eliminarRolPorTerceroAsync('@item.IntAspNetTerceroRolesID');"><i class="fa fa-trash-alt fa-fw"></i></button>
                    </td>

                </tr>
            }
        </tbody>
    </table>

</div>

@Html.Partial("_Modal_Titulo", new ViewDataDictionary { { "titulo", $"Usuarios asignados a la empresa" }, { "icono", "fa fa-user-plus" }, { "claseTexto", "d-none" } })

<div class="card-body pt-1">

    <div id="divGetAllUsuarios"></div>

</div>



<script type="text/javascript">

    $(document).ready(function () {

        var terceroID = $("#terceroID").val();
        usuariosCRUD.getAllUsuarios(terceroID);

        var btnAgregarRol = $("#btnAgregarRol");

        btnAgregarRol.click(function () {
            tercerosCRUD.vistaAgregarRoles();
        });

    });


</script>

