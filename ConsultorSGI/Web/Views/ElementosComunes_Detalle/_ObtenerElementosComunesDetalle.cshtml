@model Models.DTO.ElementosComunesDTO

@{
    string Estado = string.Empty;

}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger block-center" role="alert">
        @ViewBag.Error
    </div>
}
else
{
    <div class="row">
        <div class="col-md-3 pt-2 pb-2">
            <button type="button" class="btn btn-outline-dark btn-block" id="btnAgregarDetalle"><i class="fas fa-cloud-upload-alt mr-1"></i>Agregar numerales</button>

        </div>
    </div>

    @Html.AntiForgeryToken()
    <table id="tblElementosComunesDetalle" class="table table-bordered dt-responsive table-sm text-sm center-block" style="width:100%">
        <thead class="text-center text-white fondoColorSGI">
            <tr>
                <th colspan="@Model.Normas.Count">Normatividad</th>

                <th rowspan="2">Interpretación</th>
                <th rowspan="2">Estado</th>
                <th rowspan="2">Acciones</th>
            </tr>

            <tr>

                @foreach (var normas in Model.Normas)
                {
                    <th rowspan="@Model.Normas.Count">@normas.StrCodigo</th>
                }


            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.ElementosComunes_DetalleDTO)
            {
                Estado = (item.BitActivo == true ? "ACTIVO" : "INACTIVO");

                <tr>

                    @foreach (var normas in Model.Normas)
                    {
                        var modeloNumerales = item.ElementosComunes_Detalle_Numerales.FirstOrDefault(x => x.Numerales.IntNormaID == normas.IntNormaID);
                        var numeral = string.Empty;
                        var numeralDescripcion = string.Empty;
                        var soporte = string.Empty;

                        if (modeloNumerales != null)
                        {
                            numeral = modeloNumerales.Numerales.StrCodigo;
                            numeralDescripcion = modeloNumerales.Numerales.StrDescripcion;
                        }

                        <td>
                            @numeral - @numeralDescripcion
                        </td>

                    }

                    <td>@item.StrInterpretacion</td>

                    @if (item.BitActivo == true)
                    {
                        <td class="text-center"><span class="badge badge-success">@Estado</span></td>
                    }
                    else
                    {
                        <td class="text-center"><span class="badge badge-danger">@Estado</span></td>
                    }

                    <td class=" text-center">
                        <button type="button" title="Editar registro" data-toggle="tooltip" data-placement="left" class="btn btn-outline-dark btn-sm glyphicon glyphicon-edit" data-registroid="@item.IntDetalleID" data-tipoevento="editar"><i class="fa fa-edit fa-fw"></i></button>
                        <button type="button" title="Eliminar registro" data-toggle="tooltip" data-placement="left" class="btn btn-outline-danger btn-sm glyphicon glyphicon-trash" data-registroid="@item.IntDetalleID" data-tipoevento="eliminar"><i class="fa fa-trash fa-fw"></i></button>
                    </td>

                </tr>
            }

        </tbody>
    </table>
}


@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {

        var btnAgregarDetalle = $("#btnAgregarDetalle");

        btnAgregarDetalle.click(function () {
            elementosComunesDetalleCRUD.crearDetalleElementosComunesAsync($("#elementoComunID").val());
        });


        $('#tblElementosComunesDetalle tbody').on('click', 'button', function () {

            var tipoEvento = $(this).data("tipoevento");
            var registroID = $(this).data("registroid");

            if (tipoEvento == 'editar')
                return elementosComunesDetalleCRUD.getDetalleElementosComunesByEditAsync(registroID);

            if (tipoEvento == 'eliminar')
                return elementosComunesDetalleCRUD.deleteElementoComunDetalleAsync(registroID);

        });

    });


</script>



