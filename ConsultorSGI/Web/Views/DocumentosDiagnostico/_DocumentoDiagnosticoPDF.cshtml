@model Models.DTO.DocumentosDiagnosticoDTO

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
<script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>

<style type="text/css">

    .letraMediana {
        font-size: 13px;
        line-height: 17px;
    }

    h6.titulo {
        display: inline-block;
        position: relative;
    }

        h6.titulo::after {
            content: '';
            position: absolute;
            width: 60px;
            height: 2px;
            background-color: #007bff;
            top: 1.3em;
            left: 0px;
        }

        h6.titulo::before {
            content: '';
            position: absolute;
            width: 10px;
            height: 2px;
            background-color: #007bff;
            top: 1.3em;
            left: 65px;
        }


    :root {
        --card-color: rgba(54, 0, 204, 0.555);
        --card-header-color: crimson;
        --card-body-color: rgb(40, 4, 124);
        --card-footer-color: indigo;
    }

    text-primary {
        color: #007bff !important;
    }

    .card-primary.card-outline {
        border-top: 3px solid #007bff;
    }

    .card-sombra {
        box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;
    }

    .card {
        margin: 0 auto;
        background: var(--card-color);
        color: #6c757d;
        width: 100%;
        padding: 20px;
        border-radius: 20px;
        word-wrap: break-word;
    }

    .card-header {
        background-color: transparent;
        padding: 0.75rem 1.25rem;
        position: relative;
        border-top-left-radius: 0.25rem;
        border-top-right-radius: 0.25rem;
        border-bottom: none
    }

    .card-body {
        -webkit-flex: 1 1 auto;
        -ms-flex: 1 1 auto;
        flex: 1 1 auto;
        min-height: 1px;
        padding: 1.25rem;
    }

    .marcaDeAgua {
        /* the image you want to 'watermark' */
        height: 300px; /* or whatever, equal to the image you want 'watermarked' */
        width: 100%; /* as above */
        background-repeat: repeat;
        position: absolute;
        opacity: 0.08;
        top: 250px;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }

    thead {
        display: table-header-group;
    }

    tbody {
        display: table-row-group;
    }

    h5 {
        display: table-row-group
    }

    li {
        page-break-inside: avoid;
    }

    .firmas {
        page-break-inside: avoid;
    }
</style>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger block-center m-2" role="alert">
        @ViewBag.Error
    </div>
}
else
{

    <div class="card-body pb-0">

        <div class="row">

            <div class="col-4 text-center">

                <img src="@Model.InformacionEmpresa.StrUrlImagen" alt="Logo empresa" class="img" style="max-height:150px!important;max-width:150%!important" />

            </div>

            <div class="col-8 text-center" style="margin:auto!important">

                <b>Fecha: </b>@Across.Common.ObtenerFechaLargaSinHora(Model.DatFechaElaboracion)<br />

            </div>

        </div>

        <hr />

    </div>

    <div class="card-body pt-2 text-sm">

        <h5 class="font-weight-bold pb-0">@Model.InformacionEmpresa.StrNombre</h5>

        <div class="row">

            <div class="col-6">
                <p>

                    <b>Nit: </b>@Model.InformacionEmpresa.StrIdentificacion-@Model.InformacionEmpresa.IntDV<br />
                    <b>Email: </b>@Model.InformacionEmpresa.StrEmail <br />
                    <b>Teléfono: </b>@Model.InformacionEmpresa.StrTelefono <br />
                    <b>Dirección: </b>@Model.InformacionEmpresa.StrDireccion <br />
                    <b>Ciudad: </b>@Model.InformacionEmpresa.StrCiudadCodigo - @Model.InformacionEmpresa.StrCiudadNombre <b>(@Model.InformacionEmpresa.StrDepartamento)</b> <br />
                </p>
            </div>

            <div class="col-6 text-left">
                <p>
                    <b>Actividad económica: </b>@Model.InformacionEmpresa.StrActividadEconomica <br />
                    <b>Nivel aplicable: </b>@Model.InformacionEmpresa.StrNivelDescripcion <br />
                    <b>Riesgo: </b>@Model.InformacionEmpresa.StrNivelDeRiesgoDescripcion <br />
                </p>
            </div>

        </div>

        <hr />

        <h5 class=" font-weight-bold text-uppercase">
            NIVEL DE CUMPLIMIENTO POR FASES
        </h5>

        <div class="row">

            <div class="col-12">

                <ul class="nav flex-column">

                    @foreach (var item in Model.FasesDocumento.OrderBy(x => x.StrDescripcionPrimaria))
                    {
                        <li class="nav-item pt-2 d-inline">
                            @item.StrDescripcionSecundaria

                            @{
                                var resultado = Convert.ToInt16(item.DecNivelDeCumplimiento * 100);
                                var resultadoPorcentaje = $"{resultado}%";
                                var claseBarra = string.Empty;
                            }

                            @if (resultado >= 0 && resultado < 50)
                            {
                                claseBarra = "bg-danger";
                            }
                            else if (resultado >= 50 && resultado < 80)
                            {
                                claseBarra = "bg-warning";
                            }
                            else
                            {
                                claseBarra = "bg-success";
                            }

                            <div class="progress">
                                <div class="progress-bar @claseBarra font-weight-bold" role="progressbar" aria-valuenow="@resultadoPorcentaje" aria-valuemin="0" aria-valuemax="100" style="width: @resultadoPorcentaje">
                                    <span class="sr-only">@resultadoPorcentaje</span> @resultadoPorcentaje
                                </div>
                            </div>

                        </li>
                    }

                </ul>
            </div>

        </div>
        <hr />

        @foreach (var item in Model.FasesDocumento.OrderBy(x => x.StrDescripcionPrimaria))
        {
            <p class=" font-weight-bold text-uppercase">
                @item.StrDescripcionSecundaria
            </p>

            <ul class="nav flex-column pt-1">

                @foreach (var paso in Model.PasosDocumento.Where(x => x.StrFaseID == item.StrFaseID).OrderBy(x => x.IntNumero))
                {
                    <li class="nav-item pt-2 d-inline">
                        <span class="font-weight-bold">Paso N°@paso.IntNumero - </span>@paso.StrRequisito

                        @{
                            var resultado = Convert.ToInt16(paso.DecResultado * 100);
                            var resultadoPorcentaje = $"{resultado}%";
                            var claseBarra = string.Empty;
                        }


                        @if (resultado >= 0 && resultado < 50)
                        {
                            claseBarra = "bg-danger";
                        }
                        else if (resultado >= 50 && resultado < 80)
                        {
                            claseBarra = "bg-warning";
                        }
                        else
                        {
                            claseBarra = "bg-success";
                        }

                        <div class="progress">
                            <div class="progress-bar @claseBarra font-weight-bold" role="progressbar" aria-valuenow="@resultadoPorcentaje" aria-valuemin="0" aria-valuemax="100" style="width: @resultadoPorcentaje">
                                <span class="sr-only">@resultadoPorcentaje</span> @resultadoPorcentaje
                            </div>
                        </div>

                    </li>

                }

            </ul>

            <hr />


        }

        <h5 class=" font-weight-bold text-uppercase">
            PLAN DE MEJORAMIENTO
        </h5>

        @foreach (var item in Model.FasesDocumento.OrderBy(x => x.StrDescripcionPrimaria))
        {

            foreach (var paso in Model.PasosDocumento.Where(x => x.StrFaseID == item.StrFaseID && x.DocumentosDiagnosticoDetalle_PlanesDeAccionDTO.Any(y => y.BitAplica == true && y.BitSeEvidencia == false && !string.IsNullOrEmpty(y.StrPlanDeAccion))).OrderBy(x => x.IntNumero))
            {
                <p class="font-weight-bold">@paso.StrRequisito</p>

                <ul class="nav flex-column">

                    @foreach (var criterio in paso.DocumentosDiagnosticoDetalle_PlanesDeAccionDTO.Where(x => x.BitAplica == true && x.BitSeEvidencia == false && !string.IsNullOrEmpty(x.StrPlanDeAccion)))
                    {
                        var fechaCriterio = string.Empty;

                        if (criterio.DatFecha != null)
                        {
                            fechaCriterio = Across.Common.ObtenerFechaLargaSinHora(criterio.DatFecha.Value);
                        }

                        <li class="nav-item pt-2 d-inline">

                            <p>
                                @criterio.StrPlanDeAccion <br />
                                <b>Responsable: </b>@criterio.StrResponsable <br />
                                <b>Fecha: </b>@fechaCriterio <br />

                            </p>

                        </li>

                        <hr />

                    }

                </ul>

            }


        }

        <div class="firmas" style="padding-top:100px">

            <div class="row">
                <div class="col-6">
                    <img src="https://app.gestionintegralsgi.com.co/Content/images/logo.png" class="img align-content-lg-around" style="height:100px; width:100px" alt="Alternate Text" />

                </div>
                <div class="col-6"></div>
            </div>

            <div class="row">

                <div class="col-6">

                    <span class="font-weight-bold h5">@Across.Empresa.RazonSocial</span>
                    <p class="mt-0 mb-0 pt-0 pb-0">
                        <b>Nit:</b> @Across.Empresa.Nit <br />
                        @Across.Empresa.Lema  <br />
                        <b>@Across.Empresa.PaginaWeb</b>  <br />

                    </p>

                </div>

            </div>

        </div>


    </div>

}

<script type="text/javascript">

    $(document).ready(function () {


    });

</script>

