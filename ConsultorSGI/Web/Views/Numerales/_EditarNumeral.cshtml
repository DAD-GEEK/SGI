@model Models.Numerales

<input type="hidden" id="normaID" value="@ViewBag.modeloNormas.IntNormaID" />
<input type="hidden" id="numeralID" value="@Model.IntNumeralID" />

<div class=" container-fluid">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center m-2" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <form id="formGuardarGlobal" method="post" action="#">
            @Html.AntiForgeryToken()
            <div class="card card-primary card-outline">

                @Html.Partial("_Card_Titulo", ViewData["Titulo"] = $"{Model.StrCodigo} - {Model.StrDescripcion} ({ViewBag.modeloNormas.StrCodigo} - {ViewBag.modeloNormas.StrDescripcion})")

                <div class="card-body pt-0">
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="numeralCodigo">Numeral<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    <input class="form-control border-right-0 numeral" type="text" id="numeralCodigo" value="@Model.StrCodigo" placeholder="Ingrese aquí la numeral..." autocomplete="off" maxlength="50" required />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fas fa-cogs"></em>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="numeralDescripcion">Descripción<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    <input class="form-control border-right-0" type="text" id="numeralDescripcion" value="@Model.StrDescripcion" placeholder="Ingrese aquí la descripción..." autocomplete="off" maxlength="200" required />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fas fa-tags"></em>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="numeralInterpretacion">Interpretacion<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    <textarea class="form-control" placeholder="Ingrese aquí la interpretación..." id="numeralInterpretacion" rows="5" maxlength="2000">@Model.StrInterpretacion</textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group  ">
                                <div class="form-group clearfix">
                                    <div class="icheck-primary d-inline">
                                        <input type="checkbox" id="numeralActivo" checked="@Model.BitActivo">
                                        <label for="numeralActivo">
                                            ¿Activo?
                                        </label>
                                    </div>

                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                @Html.Partial("_Card_Footer")

            </div>
        </form>

    }

</div>

@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {

        numeralesCRUD.guardarNumeralAsync();

        $("#btnAtras").click(function () {
            normasCRUD.getAllNormasAsync();
        });

    });


</script>



