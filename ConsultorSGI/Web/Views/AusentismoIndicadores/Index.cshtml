@using DataAccess.Servicios;

@{
    var modulos = ServicioModulos.ObtenerInformacionDeModuloActual("AusentismoIndicadores");
}

<div class="container-fluid pt-0 mt-0">

    <div class="content-header pt-0 mt-0 pb-1">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="text-dark font-weight-bold">@modulos.ModuloDetalle.StrModuloDetalle</h1>
                <small>@modulos.ModuloDetalle.StrDescripcion</small>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action(@modulos.ModuloDetalle.StrAccion,@modulos.ModuloDetalle.StrControlador)">@modulos.ModuloPrincial.StrModulo</a></li>
                    <li class="breadcrumb-item active">@modulos.ModuloDetalle.StrModuloDetalle</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="card card-primary card-outline">

        <div id="divGetIndicadores">

            <div class="card-header border-bottom pt-2 pb-0">
                <h5 class="font-weight-bold text-uppercase"><i class="fas fa-chart-area mr-1 text-primary"></i> Medición de Ausentismo</h5>
            </div>

            <div class="card-body pt-1">

                <p>Para visualizar los indicadores seleccione un año, luego haga click sobre el indicador que desea observar. <br /></p>

                <form id="formVisualizarIndicadores">

                    <div class="row">

                        <div class="col-md-3 col-12">
                            <div class="form-group">
                                <div class=" input-group with-focus">
                                    <input class="form-control border-right-0 numerico" type="text" id="indicadoresAnio" value="@DateTime.Now.Year" placeholder="Ingrese aquí el año..." autocomplete="off" maxlength="4" required />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <i class="fas fa-chart-bar"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>

                <div class="row">

                    <div class="col-lg-6 col-12">
                        <div class="small-box bg-primary">
                            <div class="inner">
                                <h3>Ausentismo EG-AC</h3>

                                <p>Analisis del ausentismo por enfermedad común y accidente común.</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-user-times"></i>
                            </div>
                            <a href="#" class="small-box-footer" data-tipoausentismo="@Across.Enumeraciones.enumTiposGlobalesDeIncapacidad.EG_AC.ToString()" id="btnIndicadorAC_EG">Ver indicadores <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <div class="col-lg-6 col-12">
                        <div class="small-box bg-success">
                            <div class="inner">
                                <h3>Ausentismo AT-EL</h3>

                                <p>Analisis del ausentismo por accidente y enfermedad laboral.</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-user-times"></i>
                            </div>
                            <a href="#" class="small-box-footer" data-tipoausentismo="@Across.Enumeraciones.enumTiposGlobalesDeIncapacidad.AT_EL.ToString()" id="btnIndicadorAT_EL">Ver indicadores <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                </div>

            </div>

            <div id="divGetAllIndicadores"></div>

        </div>


    </div>

</div>


@section BodyArea {
    <div class=" modal fade fade bd-example-modal-sm" id="modal" tabindex="10" role="dialog" aria-hidden="true" data-backdrop="static">
        <div id="contenedor">

        </div>
    </div>
}

@section Scripts {

    <script type="text/javascript">

        $(document).ready(function () {

            $("#btnIndicadorAC_EG,#btnIndicadorAT_EL").click(function () {

                var anio = $("#indicadoresAnio").val();

                var tipoAusentismo = $(this).data('tipoausentismo');
                var form = $("#formVisualizarIndicadores");

                form.parsley().validate();

                console.log(anio);

                if (form.parsley().isValid())
                    ausentismoIndicadores.obtenerVistaIndicadores(anio, tipoAusentismo);
            });

            ausentismoIndicadores.getAll();

        });

    </script>
}



