@model Models.Cargos

<input type="hidden" id="cargoID" value="@Model.IntCargoID" />

<div class=" container-fluid">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center m-2" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <form id="formGuardarGlobal" method="post" action="#">
            @Html.AntiForgeryToken()
            <div class="card card-primary card-outline">

                @Html.Partial("_Card_Titulo", ViewData["Titulo"] = $"{Model.StrCodigo} - {Model.StrDescripcion}")

                <div class="card-body pt-0">
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="cargoCodigo">Código<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    <input class="form-control border-right-0" type="text" id="cargoCodigo" value="@Model.StrCodigo" placeholder="Ingrese aquí el código..." autocomplete="off" maxlength="50" data-parsley-type="alphanum" required />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fas fa-cogs"></em>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="cargoCodigo">Descripción<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    <input class="form-control border-right-0" type="text" id="cargoDescripcion" value="@Model.StrDescripcion" placeholder="Ingrese aquí la descripción..." autocomplete="off" maxlength="200" required />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fas fa-tags"></em>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="form-group clearfix">
                                    <div class="icheck-primary d-inline">
                                        <input type="checkbox" id="cargoActivo" checked="@Model.BitActivo">
                                        <label for="cargoActivo">
                                            ¿Activo?
                                        </label>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                @Html.Partial("_Card_Footer")

            </div>
        </form>

    }

</div>

@Scripts.Render("~/bundles/vistasParciales")

<script type="text/javascript">

    $(document).ready(function () {
        cargosCRUD.guardarCargoAsync();

        $("#btnAtras").click(function () {
            cargosCRUD.getAllCargosAsync();
        });
    });

</script>



