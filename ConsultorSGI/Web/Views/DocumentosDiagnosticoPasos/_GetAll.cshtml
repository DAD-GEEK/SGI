@model List<Models.DTO.DocumentosDiagnosticoPasosDTO>

@{
    string Estado = string.Empty;

}

<input type="hidden" id="sistemaDeGestionID" value="@ViewBag.sistemaDeGestionID" />

<div class=" container-fluid">

    <div class=" col-md-12">
        <div class="card">

            <div class="card-header fondoOscuroSGI">

                <div class="row">

                    <div class="col-md-3">

                        <button type="button" class="btn btn-outline-light btn-block" data-toggle="modal" id="btnCrearPaso"><i class="fas fa-plus"></i>&nbsp;&nbsp;Agregar nuevo paso</button>

                    </div>

                </div>

            </div>

            <div class="card-body">

                @if (ViewBag.Error != null)
                {
                    @Html.Partial("_AlertaNovedades", ViewData["error"] = ViewBag.Error)
                }
                else
                {
                    @Html.AntiForgeryToken()

                    <table id="tblPasos" class="table table-bordered dt-responsive table-sm center-block" style="width:100%">
                        <thead class="text-center text-white fondoColorSGI">
                            <tr>
                                <th>Id</th>
                                <th class="text-center">Número de paso</th>
                                <th>Fase</th>
                                <th>Nivel</th>
                                <th>Requisito</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                Estado = (item.BitActivo == true ? "ACTIVO" : "INACTIVO");

                                <tr>
                                    <td>@item.StrPasoID</td>

                                    <td class="text-center font-weight-bold h4 text-center text-danger">@item.IntNumero</td>

                                    <td>@item.StrFaseDescripcionPrimaria</td>

                                    <td class="text-center">

                                        @foreach (var nivel in item.Niveles.OrderBy(x => x.IntOrden))
                                        {
                                            <span class="badge badge-primary">@nivel.StrDescripcion</span>
                                        }

                                    </td>

                                    <td>@item.StrRequisito</td>

                                    @if (item.BitActivo == true)
                                    {
                                        <td class="text-center"><span class="badge badge-success">@Estado</span></td>
                                    }
                                    else
                                    {
                                        <td class="text-center"><span class="badge badge-danger">@Estado</span></td>
                                    }

                                    <td class=" text-center">
                                        <button type="button" title="Editar registro" data-toggle="tooltip" data-placement="left" class="btn btn-outline-dark btn-sm  glyphicon glyphicon-edit" data-registroid="@item.StrPasoID" data-tipoevento="editar"><i class="fa fa-edit fa-fw"></i></button>
                                        <button type="button" title="Eliminar registro" data-toggle="tooltip" data-placement="left" class="btn btn-outline-danger btn-sm  glyphicon glyphicon-trash" data-registroid="@item.StrPasoID" data-tipoevento="eliminar"><i class="fa fa-trash fa-fw"></i></button>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>

<script type="text/javascript">

    $(document).ready(function () {

        var btnCrearPaso = $("#btnCrearPaso");

        btnCrearPaso.click(function () {
            documentosDiagnosticoPasosCRUD.crear();
        });

        var tblPasos = $('#tblPasos').DataTable({

            "order": [[1, "asc"]],
            "columnDefs": [
                {
                    "targets": [0],
                    "visible": false,
                    "searchable": false
                }],
            "language": {
                "sProcessing": "Procesando...",
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "Ningún dato disponible en esta tabla",
                "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                "sInfoPostFix": "",
                "sSearch": "Buscar:",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Cargando...",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Último",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                },
                "oAria": {
                    "sSortAscending": ": Activar para ordenar la columna de manera ascendente",
                    "sSortDescending": ": Activar para ordenar la columna de manera descendente"
                }
            },

            "lengthMenu": [[10, 20, 50, 100], [10, 20, 50, 100]]
        });

        $('#tblPasos tbody').on('click', 'button', function () {

            var tipoEvento = $(this).data("tipoevento");
            var registroID = $(this).data("registroid");

            if (tipoEvento == 'editar')
                return documentosDiagnosticoPasosCRUD.getByEditar(registroID);

            if (tipoEvento == 'eliminar')
                return documentosDiagnosticoPasosCRUD.delete(registroID);

        });

    });


</script>


