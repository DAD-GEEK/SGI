@model Models.DTO.ContratosDTO
@using System.Globalization;

@{
    Layout = null;

    var fechaInicial = Model.DatFechaInicial.ToString("yyyy-MM-dd", CultureInfo.CreateSpecificCulture("es-Mx"));
    var fechaFinal = Model.DatFechaFinal.ToString("yyyy-MM-dd", CultureInfo.CreateSpecificCulture("es-Mx"));

}

<input type="hidden" id="editarNumeroContrato" value="@Model.IntNumeroContrato" />

<div class="modal-dialog " style=" max-width:500px!important; max-height:100vh!important;">
    <div class="modal-content card card-outline card-primary ">
        <div class="modal-header bg-light pl-4 ">
            <h3 class="modal-title font-weight-bold h4" id="myModalLabel"><span class=""><em class="fa fa-clipboard-check text-gray "></em></span>&nbsp; Modificar contrato</h3>
            <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>


        <form method="post" action="#" id="formEditarContrato">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="editarFechaInicialContrato">Fecha inicial<span class="text-danger">*</span></label>
                                <div class="input-group date timepickerFecha" id="timepickerEditarFechaInicialContrato" data-target-input="nearest" data-target="#timepickerEditarFechaInicialContrato" data-toggle="datetimepicker">
                                    <input type="text" class="form-control datetimepicker-input border-right-0" id="editarFechaInicialContrato" value="@fechaInicial" placeholder="Fecha inicial" autocomplete="off" data-target="#timepickerEditarFechaInicialContrato" data-parsley-required data-parsley-errors-container="#errorEditarFechaInicialContrato" />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fas fa-calendar-check"></em>
                                        </span>
                                    </div>
                                </div>
                                <span class="text-danger" id="errorEditarFechaInicialContrato"><small></small> </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="editarFechaFinalContrato">Fecha inicial<span class="text-danger">*</span></label>
                                <div class="input-group date timepickerFecha" id="timepickerEditarFechaFinalContrato" data-target-input="nearest" data-target="#timepickerEditarFechaFinalContrato" data-toggle="datetimepicker">
                                    <input type="text" class="form-control datetimepicker-input border-right-0" id="editarFechaFinalContrato" value="@fechaFinal" placeholder="Fecha final" autocomplete="off" data-target="#timepickerEditarFechaFinalContrato" data-parsley-required data-parsley-errors-container="#errorEditarFechaFinalContrato" />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fas fa-calendar-check"></em>
                                        </span>
                                    </div>
                                </div>
                                <span class="text-danger" id="errorEditarFechaFinalContrato"><small></small> </span>

                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="editarHorasContrato">Horas mensuales<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    <input class="form-control border-right-0 info" name="editarHorasContrato" id="editarHorasContrato" value="@Model.IntHoras" type="number" placeholder="Horas mensuales" autocomplete="off" data-parsley-required data-parsley-errors-container="#errorEditarHorasContrato" />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fa fa-sort-numeric-up"></em>
                                        </span>
                                    </div>
                                </div>
                                <div class="text-danger" id="errorEditarHorasContrato"></div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="editarValorContrato">Valor mensual<span class="text-danger">*</span></label>
                                <div class=" input-group with-focus">
                                    <input class="form-control border-right-0 info" name="editarValorContrato" id="editarValorContrato" value="@Model.IntValor" type="text" placeholder="Valor contrato" autocomplete="off" data-parsley-required data-parsley-errors-container="#errorEditarFechaFinalContrato"  />
                                    <div class="input-group-append">
                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                            <em class="fa fa-sort-numeric-up-alt"></em>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="asesorasContrato">Asesor<span class="text-danger">*</span></label>
                                @Html.DropDownList("listaUsuarios", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "form-control select2 select2-purple contrato", style = "width: 100%;", multiple = "multiple", id = "editarAsesorasContrato", data_parsley_required = "required", data_parsley_errors_container = "#errorEditarAsesorasContrato" })
                                <span class="text-danger" id="errorEditarAsesorasContrato"><small></small> </span>
                            </div>
                        </div>

                        <div class="col-lg-12">
                            <div class="form-group">
                                <label class="form-control-label font-weight-bold" for="sistemasContrato">Sistema<span class="text-danger">*</span></label>
                                @Html.DropDownList("listaSistemas", null, "-- Seleccione una opción --", htmlAttributes: new { @class = "form-control select2 contrato", style = "width: 100%;", multiple = "multiple", id = "editarSistemasContrato", data_parsley_required = "required", data_parsley_errors_container = "#errorEditarSistemasContrato" })
                                <span class="text-danger" id="errorEditarSistemasContrato"><small></small> </span>
                            </div>
                        </div>


                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6 mr">

                        </div>

                        <div class="col-md-6">
                            <div class="row">

                                <div class="col-xs-12 col-md-6">
                                    <button type="button" data-dismiss="modal" class="btn btn-block btn-dark">Cancelar</button>
                                </div>

                                <div class="col-xs-12 col-md-6">
                                    <button type="submit" class="btn btn-primary btn-block ">Guardar</button>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

<!--Cargar asesores en el contrato-->
<div id="contratosUsuarios" style="display:none;">
    @foreach (var item in Model.ContratosUsuariosDTO)
    {
        <span>@item.IntUsuarioID</span>
    }
</div>

<!--Cargar asesores en el contrato-->
<div id="contratosSistemas" style="display:none;">
    @foreach (var item in Model.ContratosSistemasDTO)
    {
        <span>@item.IntSistemaID</span>
    }
</div>


<script src="@Scripts.Url("~/Plugins/Parsley/parsley.js")"></script>


<link href="~/Plugins/Parsley/Parsley.css" rel="stylesheet" />
<script type="text/javascript">

    $(function () {

        clientesCRUD.updateContratoInFront();

        $(document).ready(function () {

            //Inicializar Select2
            $("#editarAsesorasContrato,#editarSistemasContrato").select2({
                placeholder: '-- Selecccione una opción --',
                theme: 'default'
            });
          
            //Inicializar fechas
            $('#timepickerEditarFechaInicialContrato').datetimepicker({
                format: 'YYYY-MM-DD',
                locale: 'es',
                icons: {
                    time: "fa fa-clock",
                    date: "fa fa-calendar",
                    up: "fa fa-arrow-up",
                    down: "fa fa-arrow-down"
                }
            });

            $('#timepickerEditarFechaFinalContrato').datetimepicker({
                format: 'YYYY-MM-DD',
                locale: 'es',
                icons: {
                    time: "fa fa-clock",
                    date: "fa fa-calendar",
                    up: "fa fa-arrow-up",
                    down: "fa fa-arrow-down"
                },
            });

            var valorContrato = $("#editarValorContrato").val();
            $("#editarValorContrato").val(clientesCRUD.formatearNumeros(valorContrato, "moneda"));

            $("#editarValorContrato").keyup(function () {
                var valor = parseInt(($(this).val().replace(/\,/gi, '')).replace("$", ""));

                $("#editarValorContrato").val(clientesCRUD.formatearNumeros(valor, "moneda"));
            });

            //Cargar select multiple de Asesores
            var i = 0;
            var usuariosSelect = [];
            $("#editarAsesorasContrato > option").each(function (i, o) {
                var lista = $(o).val();
                $("#contratosUsuarios > span").each(function (i, span) {
                    var selec = $(span).html();

                    if (selec == lista) {
                        usuariosSelect[i] = lista;
                    }
                });
                i = i + 1;
            });
            $('#editarAsesorasContrato').val(usuariosSelect).trigger('change');

            //Cargar select multiple de sistemas
            var i = 0;
            var sistemasSelect = [];
            $("#editarSistemasContrato > option").each(function (i, o) {
                var lista = $(o).val();
                $("#contratosSistemas > span").each(function (i, span) {
                    var selec = $(span).html();

                    if (selec == lista) {
                        sistemasSelect[i] = lista;
                    }
                });
                i = i + 1;

            });
            $('#editarSistemasContrato').val(sistemasSelect).trigger('change');
        });
    });

</script>
