@model List<Models.Contactos>
<div class="row">
    <div class="col-lg-12">
        <div class="card-body p-0">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger block-center" role="alert">
                    @ViewBag.Error
                </div>
            }
            else
            {
                <table class="table table-responsive-lg table-sm " id="tblContactos" style="width:100% !important">
                    <thead>
                        <tr>
                            <th style="width: 10px; display: none; ">ContratoID</th>
                            <th>Nombre</th>
                            <th>Cargo</th>
                            <th>Teléfono</th>
                            <th>Celular</th>
                            <th>Email</th>
                            <th class="text-center" style="width:30px">&nbsp;</th>

                        </tr>
                    </thead>
                    <tbody id="divGenerarDetalleContacto">
                    </tbody>
                </table>

            }

        </div>

    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {

        $('[data-toggle="tooltip"]').tooltip();

    });

</script>