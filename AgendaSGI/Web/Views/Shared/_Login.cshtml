@model Models.Usuarios

<div id="fondo"></div>

<div class="login-box">
    <!-- /.login-logo -->
    <div class="card card-outline card-primary">

        @*<div class="card-header text-center">
                <a href="#" class="h1"><b>Gestión Integral</b> SGI</a>
            </div>*@
        Layout
        <div class="login-logo">
            <img src="~/Content/images/logo.png" class="img-responsive pt-3 pb-3" alt="Logo SGI" style="padding:30px 100px 0px 100px; width:100%" />

        </div>

        <form action="#" method="post" id="formValidarLogin">
            @Html.AntiForgeryToken()
            <div class="card-body pt-0">
                <p class="login-box-msg font-weight-bold">Iniciar sesión en la aplicación</p>

                <div class="input-group mb-3 pb-0">
                    <input type="text" class="form-control border-right-0" id="usuarioLogin" placeholder="Usuario" autocomplete="off" data-parsley-required data-parsley-errors-container="#errorLoginUsuario">
                    <div class="input-group-append">
                        <span class="input-group-text text-muted bg-transparent border-left-0">
                            <i class="fa fa-user"></i>
                        </span>
                    </div>
                </div>
                <span class="text-danger pt-0 " id="errorLoginUsuario"><small></small> </span>


                <div class="input-group mb-3">
                    <input type="password" class="form-control" id="contraseñaLogin" placeholder="Contraseña" data-parsley-required data-parsley-errors-container="#errorLoginContraseña">
                    <div class="input-group-append">
                        <span class="input-group-text text-muted bg-transparent border-left-0">
                            <i class="fas fa-lock"></i>
                        </span>
                    </div>
                </div>
                <span class="text-danger" id="errorLoginContraseña"><small></small> </span>


                <span class="text-danger" id="errorLogin"></span>

                <div class="social-auth-links text-center mt-2 mb-3  ">
                    <button type="submit" class="btn btn-block btn-primary">
                        <i class="fas fa-sign-in-alt mr-2"></i> <span class="font-weight-bold">Iniciar sesión</span>
                    </button>
                </div>


                <!-- /.social-auth-links -->

                <div class="row">
                    <div class="col-12 pb-2">
                        <div class="icheck-primary">
                            <input type="checkbox" id="remember">
                            <label for="remember">
                                Recordar
                            </label>
                        </div>
                    </div>

                </div>

                <p class="mb-1">
                    <a href="forgot-password.html">Olvidé mi contraseña</a>
                </p>

            </div>
        </form>

    </div>
</div>

<script src="@Scripts.Url("~/Scripts/app.js")"></script>


<script type="text/javascript">

    $(function () {

        usuarioAutenticacion.validarLoginAsync();

    });

</script>
