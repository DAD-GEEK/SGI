@model Models.ActividadesActa

@{
    Layout = null;
}


<div class="modal-dialog " style=" max-width:700px!important;">
    <div class="modal-content card card-outline card-primary ">
        <div class="modal-header bg-light pl-4 ">
            <h3 class="modal-title font-weight-bold h4" id="myModalLabel"><span class=""><em class="fa fa-user-plus text-gray "></em></span>&nbsp; Editar Actividad</h3>
            <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <form method="post" action="#" id="formEditarActividad">
            @Html.AntiForgeryToken()

            <div class="modal-body" style=" max-height:100vh!important;">
                <div class="container-fluid">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger block-center" role="alert">
                            @ViewBag.Error
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="form-control-label font-weight-bold" for="editarActividadDescripcion">Actividad<span class="text-danger">*</span></label>
                                    <div class=" input-group with-focus">
                                        <textarea class="form-control" name="editarActividadDescripcion" id="editarActividadDescripcion" data-parsley-required data-parsley-errors-container="#errorEditarActividadDescripcion">@Model.StrDescripcion</textarea>
                                    </div>
                                </div>
                                <span class="text-danger" id="errorEditarActividadDescripcion"><small></small> </span>

                            </div>

                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="form-control-label font-weight-bold" for="editarActividadResponsable">Responsable<span class="text-danger">*</span></label>
                                    <div class=" input-group with-focus">
                                        <input class="form-control border-right-0" name="editarActividadResponsable" id="editarActividadResponsable" value="@Model.StrResponsable" type="text" placeholder="Responsable actividad..." autocomplete="off" data-parsley-required data-parsley-errors-container="#errorEditarActividadResponsable" />
                                        <div class="input-group-append">
                                            <span class="input-group-text text-muted bg-transparent border-left-0">
                                                <em class="fa fa-user"></em>
                                            </span>
                                        </div>
                                    </div>
                                    <span class="text-danger"><small></small> </span>
                                </div>
                            </div>


                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="form-control-label font-weight-bold" for="fechaActividad">Fecha actividad<span class="text-danger">*</span></label>
                                    <div class=" input-group with-focus">
                                        <div class="input-group date timepickerFecha" id="timepickerEditarFechaActividad" data-target-input="nearest" data-target="#timepickerEditarFechaActividad" data-toggle="datetimepicker">
                                            <input type="text" class="form-control datetimepicker-input border-right-0" id="editarActividadFecha" value="@Model.DatFecha.Value.ToString("yyyy-MM-dd")" autocomplete="off" placeholder="Fecha de la actividad..." data-target="#timepickerEditarFechaActividad" data-parsley-required data-parsley-errors-container="#errorEditarFechaActividad" />
                                            <div class="input-group-append">
                                                <span class="input-group-text text-muted bg-transparent border-left-0">
                                                    <em class="fas fa-calendar-check"></em>
                                                </span>
                                            </div>
                                        </div>
                                        <span class="text-danger" id="errorEditarFechaActividad"><small></small> </span>

                                    </div>
                                </div>
                            </div>


                        </div>

                    }

                </div>
            </div>

            <div class="modal-footer bg-light">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">

                        </div>

                        <div class="col-md-6">
                            <div class="row">

                                <div class="col-xs-12 col-md-6">
                                    <button type="button" data-dismiss="modal" class="btn btn-block btn-dark">Cancelar</button>
                                </div>

                                <div class="col-xs-12 col-md-6">
                                    <button type="submit" class="btn btn-primary btn-block">Guardar</button>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="@Scripts.Url("~/Scripts/app.js")"></script>

@*<script src="@Scripts.Url("~/Plugins/Parsley/parsley.js")"></script>*@

<link href="~/Plugins/Parsley/Parsley.css" rel="stylesheet" />
<script type="text/javascript">

    $(function () {

        actaCRUD.updateActividadInFront();

        $(document).ready(function () {
            $('#timepickerEditarFechaActividad').datetimepicker({
                format: 'YYYY-MM-DD',

                locale: 'es',
                icons: {
                    time: "fa fa-clock",
                    date: "fa fa-calendar",
                    up: "fa fa-arrow-up",
                    down: "fa fa-arrow-down"
                }
            });
        });
    });

</script>

