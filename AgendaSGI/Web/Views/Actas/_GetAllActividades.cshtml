@model List<Models.ActividadesActa>
@using System.Text.RegularExpressions;


@{
    string fecha = string.Empty;
}


<div class="row">
    <div class="col-lg-12">
        <div class="card-body p-0">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger block-center" role="alert">
                    @ViewBag.Error
                </div>
            }
            else
            {

                <table class="table table-responsive-lg table-sm" id="tblActividades" style="width:100% !important">
                    <thead>
                        <tr>
                            <th style="display: none; ">ActividadID</th>
                            <th>Actividad</th>
                            <th>Responsable</th>
                            <th class="text-center">Fecha</th>
                            <th class="text-center">Ejecuta</th>
                            <th class="text-center" style="width:100px">&nbsp;</th>

                        </tr>
                    </thead>
                    <tbody id="tblDetalleActividades" style="width:100%!important">

                        @foreach (var item in Model)
                        {
                            if (item.DatFecha.HasValue)
                            {
                                fecha = item.DatFecha.Value.ToString("yyyy-MM-dd");
                            }
                            <tr class="item" data-id="@item.IntActividadID">

                                <td style="text-align:center; display:none;"><span class="iActividadID">@item.IntActividadID</span></td>
                                <td class=""><span class="iActividadDescripcion text-muted ">@item.StrDescripcion</span></td>
                                <td class=""><span class="iActividadResponsable text-muted">@item.StrResponsable</span></td>
                                <td class="text-center"><span class="iActividadFecha text-muted">@fecha</span></td>

                                @if (item.OpcEjecuta != true)
                                {
                                    <td class="text-center h5"><a href="#" class="iActividadEstado" data-estado="False" data-id="@item.IntActividadID" onclick="actaCRUD.cambiarEstadoActividad(this)"><span class="badge badge-danger">NO</span></a></td>

                                }
                                else
                                {
                                    <td class="text-center h5"><a href="#" class="iActividadEstado" data-estado="True" data-id="@item.IntActividadID" onclick="actaCRUD.cambiarEstadoActividad(this)"><span class="badge badge-success">SI</span></a></td>

                                }
                                <td class="text-right">
                                    <button type="button" class="btn bg-white pr-0 mr-1" data-actividad="@item.StrDescripcion" data-responsable="@item.StrResponsable" data-fecha="@item.DatFecha" onclick="actaCRUD.getActividadParaEditarAsync(this);"><i class="fa fa-edit fa-1x text-info"></i></button>
                                    <button type="button" class="btn bg-white p-0 remove-item enviado" data-id="@item.IntActividadID" onclick="actaCRUD.identificarActividadesDeleted(this);"><em class="fa fa-trash-alt fa-1x text-danger"></em> </button>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            }
        </div>

    </div>
</div>
<script src="@Scripts.Url("~/Scripts/app.js")"></script>

<script type="text/javascript">

    $(document).ready(function () {

        $('[data-toggle="tooltip"]').tooltip();

        $('#tblActividades > tr').click(function () {
            var i = $(this).index();
            alert('Has clickado sobre el elemento número: ' + i);
        });

        $("#tblDetalleActividades > tr").each(function (i, tr) {

            var descripcion = $(tr).find(".iActividadDescripcion").html();
            descripcion = unescape(descripcion);
            $(tr).find(".iActividadDescripcion").html(descripcion);

            //Si el acta ya fue enviada
            if ($("#opcEnviado").prop("checked")) {
                $(".enviado", tr).attr("disabled", true);
            }

            $('.remove-item').off().click(function (e) {
                $(this).parent('td').parent('tr').remove();
            });

        });

    });

</script>
