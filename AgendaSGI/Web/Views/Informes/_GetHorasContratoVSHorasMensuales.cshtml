@model List<Models.DTO.InformesDTO>


<div class="card-body pt-0">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger block-center m-2" role="alert">
            @ViewBag.Error
        </div>
    }
    else
    {
        <div class="table-responsive p-0">
            <table class="table table-striped table-valign-middle" id="tblHoras">
                <thead>
                    <tr>
                        <th>Nit</th>
                        <th>Nombre</th>
                        <th class="text-center">Horas Contrato</th>
                        <th class="text-center">Horas Ejecutadas</th>
                        <th class="text-center">Diferencia</th>

                    </tr>
                </thead>
                <tbody id="detalleHorasContrato">
                    @foreach (var item in Model.OrderBy(x => x.diferencia))
                    {
                        double diferencia = (Convert.ToDouble(item.HorasContrato) - Convert.ToDouble(item.HorasMes));
                        string nuevo = string.Empty;
                        var dias = DateTime.Now - item.FechaIngreso;

                        <tr>
                            <td class="clienteIdentificacion font-weight-bold">@item.Identificacion</td>
                            @if (dias.TotalDays < 15)
                            {
                                <td class="clienteNombre">@item.Nombre &nbsp;&nbsp;<span class="badge badge-success" style="font-size:9px;"> CLIENTE NUEVO</span></td>
;
                            }
                            else
                            {
                                <td class="clienteNombre">@item.Nombre</td>
                            }

                            <td class="text-center">@item.HorasContrato</td>
                            <td class="text-center">@item.HorasMes</td>
                            @if (diferencia == 0)
                            {
                                <td class="text-center badge badge-success align-content-center" style="width:100%; padding-top:10px;"><span class="font-weight-bold h5">@diferencia Horas</span> </td>
                            }
                            else if (diferencia > 0)
                            {
                                <td class="text-center badge badge-warning align-content-center" style="width:100%; padding-top:10px;"><span class="font-weight-bold h5">@diferencia Horas</span> </td>
                            }
                            else
                            {
                                <td class="text-center badge badge-danger align-content-center" style="width:100%;"><span class="font-weight-bold h5">@diferencia Horas</span> </td>
                            }


                        </tr>

                    }
                </tbody>
            </table>
        </div>


    }
</div>


<script type="text/javascript">
    $(document).ready(function () {

        $("#detalleHorasContrato > tr").each(function (i, tr) {
            var nit = $(".clienteIdentificacion", tr).html();
            $(".clienteIdentificacion", tr).html(clientesCRUD.formatearNumeros(nit, "punto"));

        });

    });


</script>


