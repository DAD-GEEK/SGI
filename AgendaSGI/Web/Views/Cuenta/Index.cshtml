@{ 
    Models.Usuarios usuario = (Models.Usuarios)HttpContext.Current.Session["Usuario"];

    string usuarioNombre = string.Empty;

    if (usuario != null)
    {
        usuarioNombre = usuario.StrNombre;
    }

}

<div class="content-header pt-0 mt-0">
    <div class="container-fluid pt-0 mt-0">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="text-dark font-weight-bold">Mi perfil</h1>
                <small>@usuarioNombre</small>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">SGIapp</a></li>
                    <li class="breadcrumb-item active">Mi perfil</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div id="divGetMiPerfil">



</div>

@section BodyArea {
    <div class=" modal fade fade bd-example-modal-sm" id="modal" tabindex="10" role="dialog" aria-hidden="true" data-backdrop="static">
        <div id="contenedor">

        </div>
    </div>
}

<script src="@Scripts.Url("~/Scripts/modulos/Cuenta/index.js")"></script>


@section Scripts {

    <script type="text/javascript">

        $(document).ready(function () {
            AccountUsuario.getPerfilEditarAsync()

        });

    </script>
}
