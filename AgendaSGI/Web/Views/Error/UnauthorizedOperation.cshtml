<div class="content-header pt-0 mt-0">
    <div class="container-fluid pt-0 mt-0">
        <div class="row">
            <div class="col-sm-6">
                <h1 class="text-dark font-weight-bold">Página de error</h1>
                <small>Error de autorización de acceso</small>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Error</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="error-page">
        <h2 class="headline text-danger"><i class="fas fa-exclamation-triangle text-warning"></i></h2>

        <div class="error-content">
            <h3 class="font-weight-bold text-primary">Módulo de @ViewBag.Modulo</h3>

            <p>
               @ViewBag.MsjExcepcion
            </p>

        
        </div>
    </div>
    <!-- /.error-page -->

</section>