
@{
    Layout = null;
}

<div class="modal-dialog " style=" max-width:600px!important; max-height:75vh!important;">
    <div class="modal-content card card-outline card-primary ">
        <div class="modal-header bg-light pl-4 ">
            <h3 class="modal-title font-weight-bold h4" id="myModalLabel"><span class=""><em class="fas fa-align-justify text-gray "></em></span>&nbsp; Agregar numeral</h3>
            <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <form method="post" action="#" id="formCrearGlobal">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12" style="height:auto">

                            <div class="card card-primary card-outline card-outline-tabs">

                                <div class="card-body pt-1">

                                    <div class="row">
                                        <div class="col-md-12 pb-1 pt-0">
                                            <small>Campos obligatorios <span class="text-danger">*</span> </small>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <label class="form-control-label font-weight-bold" for="numeralDescripcion">Descripción<span class="text-danger">*</span></label>
                                                <div class=" input-group with-focus">
                                                    <input class="form-control border-right-0 info" name="numeralDescripcion" id="numeralDescripcion" type="text" placeholder="Descripción del numeral..." autocomplete="off" maxlength="50" data-parsley-required data-parsley-errors-container="#errorNumeralDescripcion" />
                                                    <div class="input-group-append" id="codigoIcono">
                                                        <span class="input-group-text text-muted bg-transparent border-left-0">
                                                            <em class="fa fa-cogs"></em>
                                                        </span>
                                                    </div>
                                                </div>
                                                <span class="text-danger" id="errorNumeralDescripcion"><small></small> </span>
                                            </div>
                                        </div>

                                    </div>
                                    <!-- /.card -->
                                </div>

                            </div>


                        </div>

                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6 mr">

                        </div>

                        <div class="col-md-6">
                            <div class="row">

                                <div class="col-xs-12 col-md-6">
                                    <button type="button" data-dismiss="modal" class="btn btn-block btn-dark">Cancelar</button>
                                </div>

                                <div class="col-xs-12 col-md-6">
                                    <button type="submit" class="btn btn-primary btn-block ">Guardar</button>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

<script src="@Scripts.Url("~/Scripts/app.js")"></script>

<script type="text/javascript">

    $(function () {

        $(document).ready(function () {

            numeralesCRUD.crearNumeralAsync();

        });
    });

</script>
